@model List<Final_Year_Project.Models.Address.AddressViewModel>

<div x-data="{ showAddModal: false, showEditModal: false, editAddress: {} }" class="max-w-3xl mx-auto mt-10 bg-white p-6 rounded-lg shadow">
    @if (ViewBag.Error != null)
    {
        <div class="mb-4 p-3 bg-red-100 border border-red-400 text-red-700 rounded">
            @ViewBag.Error
        </div>
    }

    <h2 class="text-2xl font-bold mb-4">My Addresses</h2>

    @if (Model.Any())
    {
        @foreach (var address in Model)
        {
            <div class="border p-4 rounded mb-4 @(address.IsDefault ? "bg-green-50 border-green-400" : "bg-gray-50")">
                <p>
                    <strong>Address:</strong>
                    @(string.IsNullOrEmpty(address.UnitNo) ? "" : address.UnitNo + ", ")
                    @address.AddressName, @address.PostalCode, @address.State
                </p>
                @if (address.IsDefault)
                {
                    <span class="text-sm text-green-600 font-semibold">Default</span>
                }

                <div class="mt-2 flex gap-3">
                    <button type="button"
                            class="text-blue-500 hover:underline"
                            x-on:click="showEditModal = true; editAddress = {
                                                AId: '@address.AId',
                                                AddressName: '@address.AddressName',
                                                PostalCode: '@address.PostalCode',
                                                State: '@address.State.Replace(" ", "_")',
                                                UnitNo: '@address.UnitNo',
                                                IsDefault: @address.IsDefault.ToString().ToLower()
                                            }">
                        Edit
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-gray-600 mb-4">You don’t have any saved addresses yet.</p>
    }

    <button type="button"
            class="bg-gray-800 hover:bg-black text-white px-4 py-2 rounded justify-end"
            x-on:click="showAddModal = true; $nextTick(()=>{ if($refs.addForm) $refs.addForm.reset(); editAddress = {}; })">
        Add Address
    </button>

    <div x-show="showAddModal"
         x-transition.opacity
         class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
         x-cloak>
        <div x-transition.scale
             class="bg-white w-full max-w-md p-6 rounded-2xl shadow-xl relative">
            <h2 class="text-xl font-semibold mb-4 text-gray-800">Add New Address</h2>

            <form asp-action="AddAddress"
                  method="post"
                  class="space-y-4"
                  x-ref="addForm"
                  x-data="addressValidation()"
                  x-on:submit.prevent="validate($refs.addForm)">

                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Unit Number (Optional)</label>
                    <input name="UnitNo" class="border border-gray-300 rounded-md w-full px-3 py-2" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Street Name</label>
                    <input name="AddressName" class="border border-gray-300 focus:ring focus:ring-gray-300 focus:border-gray-400 rounded-md w-full px-3 py-2" required />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">State</label>
                    <select name="State" class="border border-gray-300 focus:ring focus:ring-gray-300 rounded-md w-full px-3 py-2" required>
                        <option value="">-- Select State --</option>
                        @foreach (var state in Enum.GetValues(typeof(Final_Year_Project.Enums.StateCategory)))
                        {
                            <option value="@state">@state</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Postal Code</label>
                    <input name="PostalCode" class="border border-gray-300 rounded-md w-full px-3 py-2" required />
                </div>
                <p x-show="postalError" class="text-red-600 text-sm" x-text="postalError"></p>

                <input type="checkbox" name="IsDefault" value="true"
                       class="h-4 w-4 text-gray-800 rounded border-gray-300"
                       x-bind:checked="editAddress.IsDefault === true || editAddress.IsDefault === 'true'" />
                <label class="text-sm text-gray-700">Set as Default</label>

                <div class="flex justify-end gap-2 pt-4">
                    <button type="button"
                            class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded-md"
                            x-on:click="showAddModal = false; $nextTick(()=>{ if($refs.addForm) $refs.addForm.reset(); })">
                        Cancel
                    </button>
                    <button type="submit"
                            class="bg-gray-800 hover:bg-black text-white px-4 py-2 rounded-md">
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div x-show="showEditModal"
         x-transition.opacity
         class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
         x-cloak>
        <div x-transition.scale
             class="bg-white w-full max-w-md p-6 rounded-2xl shadow-xl relative">
            <h2 class="text-xl font-semibold mb-4 text-gray-800">Edit Address</h2>

            <form x-bind:action="'/Profile/Address/EditAddress?id=' + (editAddress.AId ?? '')"
                  method="post"
                  class="space-y-4"
                  x-ref="editForm"
                  x-data="addressValidation(editAddress)"
                  x-on:submit.prevent="validate($refs.editForm)">

                @Html.AntiForgeryToken()
                <input type="hidden" name="id" x-bind:value="editAddress.AId" />

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Unit Number (Optional)</label>
                    <input name="UnitNo" x-model="editAddress.UnitNo" class="border border-gray-300 rounded-md w-full px-3 py-2" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Street Name</label>
                    <input name="AddressName" x-model="editAddress.AddressName" class="border border-gray-300 rounded-md w-full px-3 py-2" required />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">State</label>
                    <select name="State" x-model="editAddress.State" class="border border-gray-300 rounded-md w-full px-3 py-2" required>
                        <option value="">-- Select State --</option>
                        @foreach (var state in Enum.GetValues(typeof(Final_Year_Project.Enums.StateCategory)))
                        {
                            <option value="@state">@state</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Postal Code</label>
                    <input name="PostalCode" x-model="editAddress.PostalCode" class="border border-gray-300 rounded-md w-full px-3 py-2" required />
                </div>
                <p x-show="postalError" class="text-red-600 text-sm" x-text="postalError"></p>


                <input type="checkbox" name="IsDefault" value="true"
                       class="h-4 w-4 text-gray-800 rounded border-gray-300"
                       x-bind:checked="editAddress.IsDefault === true || editAddress.IsDefault === 'true'" />
                <label class="text-sm text-gray-700">Set as Default</label>

                <div class="flex justify-end gap-2 pt-4">
                    <button type="button"
                            class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded-md"
                            x-on:click="showEditModal = false; $nextTick(()=>{ editAddress = {}; })">
                        Cancel
                    </button>
                    <button type="submit"
                            class="bg-gray-800 hover:bg-black text-white px-4 py-2 rounded-md">
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const postalRules = {
            "Johor":        { min: 79000, max: 86999 },
            "Kedah":        { min: 5000,  max: 98100 },
            "Kelantan":     { min: 15000, max: 18599 },
            "Melaka":       { min: 75000, max: 78399 },
            "Negeri Sembilan": { min: 70000, max: 73599 },
            "Pahang":       { min: 25000, max: 28800 },
            "Penang":       { min: 10000, max: 14499 },
            "Perak":        { min: 30000, max: 36899 },
            "Perlis":       { min: 1000,  max: 2999 },
            "Sabah":        { min: 88000, max: 91300 },
            "Sarawak":      { min: 93000, max: 98859 },
            "Selangor":     { min: 40000, max: 48999 },
            "Terengganu":   { min: 20000, max: 24999 },
            "Kuala Lumpur": { min: 50000, max: 60000 },
            "Putrajaya":    { min: 62000, max: 62999 },
        };

        function addressValidation(existingAddress = null) {
            return {
                postalError: "",

                validate(form) {
                    const state = form.State.value;
                    const postal = form.PostalCode.value;

                    if (!state || !postal) {
                        form.submit();
                        return;
                    }

                    const rules = postalRules[state];

                    if (rules) {
                        const postalInt = parseInt(postal);
                        if (isNaN(postalInt) || postalInt < rules.min || postalInt > rules.max) {
                            this.postalError = `Postal code must be between ${rules.min} and ${rules.max}`;
                            return;
                        }
                    }

                    this.postalError = "";
                    form.submit();
                }
            };
        }
    </script>
}