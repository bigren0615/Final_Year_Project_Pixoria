@model Final_Year_Project.Models.Refund.RefundRequestViewModel

@{
    ViewData["Title"] = "Request Refund";
}

<div class="max-w-4xl mx-auto px-6 py-8">
    <div class="flex justify-between items-center mb-6">
        <a href="@Url.Action("OrderDetailHistory", "Order", new { OId = Model.OrderId })" class="flex items-center text-gray-600 hover:text-gray-900 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Back to Order Details</span>
        </a>
    </div>

    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Request Refund</h2>

        @if (!Model.IsRefundable)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4">
                <div class="flex items-center">
                    <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                    <strong>Refund Period Expired</strong>
                </div>
                <p class="mt-2">The refund deadline was @Model.RefundDueDate?.ToString("MMMM dd, yyyy"). You can no longer request a refund for this item.</p>
            </div>
        }
        else
        {
            <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded mb-4">
                <div class="flex items-center">
                    <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                    </svg>
                    <strong>Important Notice</strong>
                </div>
                <p class="mt-2">Please submit your refund request before <strong>@Model.RefundDueDate?.ToString("MMMM dd, yyyy")</strong> if the product is damaged or not as described.</p>
            </div>
        }

        <!-- Product Information -->
        <div class="bg-gray-50 rounded-lg p-4 mb-6">
            <h3 class="text-lg font-semibold mb-3">Product Information</h3>
            <div class="flex items-center space-x-4">
                @if (!string.IsNullOrEmpty(Model.ProductImage))
                {
                    <img src="@Model.ProductImage" alt="@Model.ProductName" class="w-24 h-24 object-cover rounded">
                }
                <div class="flex-1">
                    <p class="font-semibold">@Model.ProductName</p>
                    <p class="text-gray-600">Price: RM @Model.Price.ToString("F2")</p>
                    <p class="text-gray-600">Quantity: @Model.Quantity</p>
                    @if (Model.DeliveryDate.HasValue)
                    {
                        <p class="text-gray-600">Delivered: @Model.DeliveryDate.Value.ToString("MMMM dd, yyyy")</p>
                    }
                </div>
            </div>
        </div>

        @if (Model.IsRefundable)
        {
            <form asp-action="SubmitRefund" method="post" enctype="multipart/form-data" class="space-y-4">
                <input type="hidden" asp-for="OrderId" />
                <input type="hidden" asp-for="OrderItemId" />
                <input type="hidden" asp-for="ProductName" />
                <input type="hidden" asp-for="ProductImage" />

                <div>
                    <label asp-for="Reason" class="block text-sm font-medium text-gray-700 mb-2">
                        Reason for Refund <span class="text-red-500">*</span>
                    </label>
                    <textarea asp-for="Reason" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Please describe why you are requesting a refund..."></textarea>
                    <span asp-validation-for="Reason" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label for="Images" class="block text-sm font-medium text-gray-700 mb-2">
                        Upload Images (Optional)
                    </label>
                    <p class="text-sm text-gray-500 mb-2">Upload photos showing the damage or issue with the product (max 5 images)</p>
                    <input type="file" asp-for="Images" multiple accept="image/*" class="block w-full text-sm text-gray-500
                        file:mr-4 file:py-2 file:px-4
                        file:rounded-md file:border-0
                        file:text-sm file:font-semibold
                        file:bg-blue-50 file:text-blue-700
                        hover:file:bg-blue-100" />
                    <span asp-validation-for="Images" class="text-red-500 text-sm"></span>
                </div>

                <div class="flex justify-end space-x-3 pt-4">
                    <a href="@Url.Action("OrderDetailHistory", "Order", new { OId = Model.OrderId })" class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                        Cancel
                    </a>
                    <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                        Submit Refund Request
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="flex justify-end pt-4">
                <a href="@Url.Action("OrderDetailHistory", "Order", new { OId = Model.OrderId })" class="px-6 py-2 bg-gray-600 text-white rounded-md hover:bg-gray-700">
                    Back to Order
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Limit file uploads to 5 images
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            if (e.target.files.length > 5) {
                alert('You can only upload a maximum of 5 images');
                e.target.value = '';
            }
        });
    </script>
}
