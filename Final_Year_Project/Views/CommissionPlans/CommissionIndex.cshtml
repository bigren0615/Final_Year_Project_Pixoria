@using Final_Year_Project.Models.CommissionPlans
@using Final_Year_Project.Enums
@model List<CommissionPlanViewModel>

@{
    ViewData["Title"] = "Commission Plans";
    var currentPage = (int)ViewData["CurrentPage"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
    var pageSize = (int)ViewData["PageSize"]!;
    var searchQuery = (string?)ViewData["SearchQuery"];
    var currentCategory = (string?)ViewData["CurrentCategory"];
    var minPrice = (decimal?)ViewData["MinPrice"];
    var maxPrice = (decimal?)ViewData["MaxPrice"];
    var isAuthenticated = (bool)ViewData["IsAuthenticated"]!;
    var allCategories = (List<string>?)ViewData["AllCategories"] ?? new List<string>();
}

<div class="min-h-screen bg-gradient-to-b from-base-100 to-base-200">
    <div class="bg-base-100 border-b border-base-300 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 py-4">
            <!-- Search Bar -->
            <div class="mb-4">
                <form method="get" class="relative" id="searchForm">
                    <div class="flex gap-2">
                        <div class="flex-1 relative">
                            <input type="text" 
                                name="search" 
                                id="searchInput"
                                placeholder="Search commissions or artists..." 
                                value="@searchQuery"
                                class="input input-bordered w-full pl-10 rounded-lg"
                                autocomplete="off" />
                            <svg class="absolute left-3 top-3 w-5 h-5 text-base-content/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </div>
                        <input type="hidden" name="category" value="@currentCategory" />
                        <input type="hidden" name="minPrice" value="@minPrice" />
                        <input type="hidden" name="maxPrice" value="@maxPrice" />
                        <input type="hidden" name="page" value="1" />
                        <button type="submit" class="btn btn-primary rounded-lg">Search</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <div class="text-sm text-base-content/60 mt-2">
                            Searching for: <strong class="text-primary">@searchQuery</strong>
                        </div>
                    }
                </form>
            </div>

            <!-- Category Filter Buttons -->
            <div class="flex gap-2 overflow-x-auto pb-2 flex-wrap">
                <a href="?page=1@(!string.IsNullOrWhiteSpace(searchQuery) ? $"&search={Uri.EscapeDataString(searchQuery)}" : "")@(minPrice.HasValue ? $"&minPrice={minPrice}" : "")@(maxPrice.HasValue ? $"&maxPrice={maxPrice}" : "")" 
                   class="btn btn-sm @(string.IsNullOrWhiteSpace(currentCategory) ? "btn-primary" : "btn-ghost") rounded-full whitespace-nowrap">
                    All Categories
                </a>
                @foreach (var cat in allCategories)
                {
                    <a href="?category=@cat&page=1@(!string.IsNullOrWhiteSpace(searchQuery) ? $"&search={Uri.EscapeDataString(searchQuery)}" : "")@(minPrice.HasValue ? $"&minPrice={minPrice}" : "")@(maxPrice.HasValue ? $"&maxPrice={maxPrice}" : "")" 
                       class="btn btn-sm @(currentCategory == cat ? "btn-primary" : "btn-ghost") rounded-full whitespace-nowrap">
                        @(char.ToUpper(cat[0]) + cat.Substring(1).Replace("_", " "))
                    </a>
                }
            </div>

            <!-- Price Range Filter -->
            <div class="mt-4 flex gap-2 items-end flex-wrap">
                <div class="form-control flex-1 min-w-48">
                    <label class="label">
                        <span class="label-text text-sm">Min Price (RM)</span>
                    </label>
                    <input type="number" 
                        id="minPriceInput"
                        name="minPrice"
                        placeholder="0" 
                        value="@(minPrice?.ToString("F2") ?? "")"
                        step="0.01"
                        min="0"
                        class="input input-bordered input-sm rounded-lg"
                        form="priceForm" />
                </div>
                <div class="form-control flex-1 min-w-48">
                    <label class="label">
                        <span class="label-text text-sm">Max Price (RM)</span>
                    </label>
                    <input type="number" 
                        id="maxPriceInput"
                        name="maxPrice"
                        placeholder="999999" 
                        value="@(maxPrice?.ToString("F2") ?? "")"
                        step="0.01"
                        min="0"
                        class="input input-bordered input-sm rounded-lg"
                        form="priceForm" />
                </div>
                <button type="submit" 
                    form="priceForm"
                    class="btn btn-sm btn-outline rounded-lg">
                    Apply
                </button>
                @if (minPrice.HasValue || maxPrice.HasValue)
                {
                    <a href="?page=1@(!string.IsNullOrWhiteSpace(searchQuery) ? $"&search={Uri.EscapeDataString(searchQuery)}" : "")@(!string.IsNullOrWhiteSpace(currentCategory) ? $"&category={currentCategory}" : "")" 
                       class="btn btn-sm btn-ghost rounded-lg text-warning">
                        Clear Price
                    </a>
                }
            </div>

            <form method="get" id="priceForm" class="hidden">
                <input type="hidden" name="category" value="@currentCategory" />
                <input type="hidden" name="search" value="@searchQuery" />
                <input type="hidden" name="page" value="1" />
            </form>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-8">
        @if (Model.Count == 0)
        {
            <div class="flex flex-col items-center justify-center py-16">
                <svg class="w-16 h-16 text-base-content/20 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.452a6 6 0 00-3.462.422l-.3.025a6 6 0 00-3.462-.422l-2.387.452a2 2 0 00-1.022.547m19.5-3.405a2 2 0 00-1.023-.547L5.034 9.967m0 0a6 6 0 00-3.462.422l-.3.025a6 6 0 00-3.462-.422M15 12a3 3 0 11-6 0 3 3 0 016 0zm6-3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"></path>
                </svg>
                <h3 class="text-xl font-semibold text-base-content/60 mb-2">No commissions found</h3>
                <p class="text-base-content/40 mb-6">@(string.IsNullOrWhiteSpace(searchQuery) && string.IsNullOrWhiteSpace(currentCategory) ? "No available commissions at the moment" : "Try adjusting your filters")</p>
                <a href="/CommissionPlans" class="btn btn-primary rounded-lg">Clear Filters</a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                @foreach (var commission in Model)
                {
                    <div class="break-inside-avoid">
                        <a href="/CommissionPlans/@commission.CId" class="card bg-base-100 shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden group cursor-pointer h-full">
                            <figure class="relative overflow-hidden bg-gradient-to-br from-base-300 to-base-200 aspect-square">
                                <img src="@commission.ImageUrl" 
                                     alt="@commission.Title" 
                                     class="w-full h-full object-cover" />
                                
                                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-transparent opacity-0 group-hover:opacity-100 flex flex-col justify-between p-3 transition-opacity duration-300">
                                    <div class="flex gap-2 flex-wrap">
                                        <span class="badge badge-primary text-xs">
                                            @(char.ToUpper(commission.Category.ToString()[0]) + commission.Category.ToString().Substring(1).Replace("_", " "))
                                        </span>
                                    </div>
                                    <p class="text-white text-sm font-semibold line-clamp-2">@commission.Title</p>
                                </div>
                            </figure>

                            <div class="card-body p-3">
                                <h3 class="font-bold text-sm line-clamp-2 group-hover:text-primary transition-colors">
                                    @commission.Title
                                </h3>

                                <!-- Price Display -->
                                <div class="text-lg font-bold text-primary">
                                    RM @commission.TargetPrice.ToString("F2")
                                </div>

                                <!-- Artist Info -->
                                <div class="flex items-center gap-2 mt-2 pt-2 border-t border-base-300">
                                    <div class="avatar w-7 h-7 flex-shrink-0">
                                        <div class="rounded-full bg-base-300">
                                            @if (!string.IsNullOrEmpty(commission.ArtistProfilePic))
                                            {
                                                <img src="@commission.ArtistProfilePic" alt="@commission.ArtistName" />
                                            }
                                            else
                                            {
                                                <img src="/images/blank_profile.webp" alt="@commission.ArtistName" />
                                            }
                                        </div>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-xs font-semibold text-base-content/80 truncate">
                                            @commission.ArtistName
                                        </p>
                                        <p class="text-xs text-base-content/50">
                                            @commission.CreatedAt.ToString("MMM dd, yyyy")
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="flex justify-center items-center gap-2 mt-12">
                    @if (currentPage > 1)
                    {
                        <a href="?page=@(currentPage - 1)&category=@currentCategory&search=@searchQuery&minPrice=@minPrice&maxPrice=@maxPrice" 
                           class="btn btn-sm btn-ghost rounded-lg">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-ghost rounded-lg opacity-50 cursor-not-allowed" disabled>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </button>
                    }

                    <div class="flex gap-1">
                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);
                        }

                        @if (startPage > 1)
                        {
                            <a href="?page=1&category=@currentCategory&search=@searchQuery&minPrice=@minPrice&maxPrice=@maxPrice" 
                               class="btn btn-sm btn-ghost rounded-lg">1</a>
                            @if (startPage > 2)
                            {
                                <span class="flex items-center px-2">...</span>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            @if (i == currentPage)
                            {
                                <button class="btn btn-sm btn-primary rounded-lg">@i</button>
                            }
                            else
                            {
                                <a href="?page=@i&category=@currentCategory&search=@searchQuery&minPrice=@minPrice&maxPrice=@maxPrice" 
                                   class="btn btn-sm btn-ghost rounded-lg">@i</a>
                            }
                        }

                        @if (endPage < totalPages)
                        {
                            @if (endPage < totalPages - 1)
                            {
                                <span class="flex items-center px-2">...</span>
                            }
                            <a href="?page=@totalPages&category=@currentCategory&search=@searchQuery&minPrice=@minPrice&maxPrice=@maxPrice" 
                               class="btn btn-sm btn-ghost rounded-lg">@totalPages</a>
                        }
                    </div>

                    @if (currentPage < totalPages)
                    {
                        <a href="?page=@(currentPage + 1)&category=@currentCategory&search=@searchQuery&minPrice=@minPrice&maxPrice=@maxPrice" 
                           class="btn btn-sm btn-ghost rounded-lg">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-ghost rounded-lg opacity-50 cursor-not-allowed" disabled>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </button>
                    }
                </div>

                <div class="text-center mt-4 text-sm text-base-content/60">
                    Page <span class="font-semibold">@currentPage</span> of <span class="font-semibold">@totalPages</span>
                </div>
            }
        }
    </div>
</div>