@using X.PagedList.Mvc.Core
@using X.PagedList
@model IPagedList<Final_Year_Project.Models.Product.ProductSalesViewModel>

<div id="purchaseContainer" class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 w-full max-w-7xl mx-auto">
    @foreach (var item in Model)
    {
        <div class="bg-white shadow-lg rounded-2xl overflow-hidden transform hover:scale-105 transition duration-300">
            <img src="@item.PrimaryImage"
                 alt="@item.ProductName"
                 class="w-full h-56 object-cover" />

            <div class="p-5 space-y-2">
                <h3 class="text-lg font-semibold text-gray-800 truncate">@item.ProductName</h3>

                <p class="text-gray-700 font-medium">
                    RM @item.Price.ToString("F2")
                </p>

                <a href="@Url.Action("ViewArtworkDetails", "Purchase", new { id = item.PId })"
                   class="mt-3 block text-center w-full px-4 py-2 bg-pink-500 text-white font-medium rounded-lg hover:bg-pink-600 transition">
                    View Details
                </a>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p class="text-center text-gray-500 mt-5">No products found.</p>
}

<div class="flex justify-center mt-8">
    @{
        var options = new PagedListRenderOptions
        {
            UlElementClasses = new[] { "flex", "space-x-2" },
            LiElementClasses = new[] { "inline-flex" },
            PageClasses = new[]
        {
        "px-4", "py-2", "rounded-lg",
        "border", "border-gray-300",
        "text-gray-700",
        "hover:bg-pink-500", "hover:text-white",
        "transition", "duration-200"
        },
            LinkToPreviousPageFormat = "« Prev",
            LinkToNextPageFormat = "Next »",
            LinkToFirstPageFormat = "« First",
            LinkToLastPageFormat = "Last »"
        };

        var ajaxOptions = new AjaxOptions
        {
            HttpMethod = "get",
            UpdateTargetId = "purchaseContainer",
            LoadingElementId = "loader"
        };
    }

    @Html.PagedListPager(
    Model,
    p => Url.Action("PurchasePage", "Purchase", new { name = ViewBag.Name, catId = ViewBag.CatId, subCatId = ViewBag.SubCatId, page = p }),
        PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(options, ajaxOptions)
        )
</div>
