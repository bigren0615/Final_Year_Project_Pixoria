@model Final_Year_Project.Models.Product.ProductSalesViewModel

@{
    // Determine the main image (first one or fallback)
    var primaryImage = Model.ImageGallery?.FirstOrDefault() ?? "/images/no-image.png";
}

<div class="min-h-screen flex flex-col items-center bg-base-200 p-6">

    <!-- Back button -->
    <div class="mt-6 flex w-full max-w-4xl">
        <a asp-action="PurchasePage"
           class="px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition">
            ← Back to Shop
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 text-red-700 px-4 py-2 rounded mb-3">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 text-green-700 px-4 py-2 rounded mb-3">@TempData["Success"]</div>
    }

    <div class="bg-white shadow-lg rounded-2xl w-full max-w-4xl overflow-hidden p-6 mt-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div>
                <div class="flex items-center justify-center bg-gray-100 rounded-lg w-full h-96 overflow-hidden">
                    <img id="mainImage"
                         src="@primaryImage"
                         alt="@Model.ProductName"
                         class="w-full h-full object-cover rounded-lg transition duration-300" />
                </div>

                @if (Model.ImageGallery != null && Model.ImageGallery.Any())
                {
                    <div class="flex justify-center mt-3 space-x-2 flex-wrap">
                        @foreach (var img in Model.ImageGallery)
                        {
                            <img src="@img"
                                 alt="thumbnail"
                                 class="w-16 h-16 rounded-lg object-cover border border-gray-300 cursor-pointer hover:ring-2 hover:ring-pink-500 transition"
                                 onclick="document.getElementById('mainImage').src=this.src" />
                        }
                    </div>
                }
            </div>

            <div class="flex flex-col justify-between">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800">@Model.ProductName</h2>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-gray-600 mt-2">@Model.Description</p>
                    }

                    <p class="mt-3 font-semibold text-gray-800">Price: RM @Model.Price.ToString("F2")</p>
                    <p class="text-gray-700 mt-1">
                        Stock Available:
                        <span class="font-semibold">@Model.StockAvailable</span>
                    </p>

                    <p class="text-gray-700 mt-1">
                        Seller: <span class="font-semibold text-pink-600">@Model.SellerName</span>
                    </p>

                    <p class="text-gray-700 mt-1">
                        Category: <span class="font-semibold">@Model.CategoryName</span>
                    </p>

                    <p class="text-gray-700 mt-1">
                        Subcategory: <span class="font-semibold">@Model.SubCategoryName</span>
                    </p>
                </div>

                <div class="mt-6 space-y-3">
                    @if (Model.IsInCart)
                    {
                        <a asp-controller="Cart" asp-action="ViewCart"
                        class="block text-center px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition">
                            View Cart
                        </a>
                    }
                    else if(Model.Status == "available" || Model.StockAvailable > 0)
                    {
                        <form asp-action="AddToCart" method="post" class="space-y-3">
                            <input type="hidden" name="PId" value="@Model.PId" />
                            <div class="flex items-center space-x-3">
                                <label for="quantity" class="text-gray-700 font-medium">Quantity:</label>
                                <input type="number" name="quantity" id="quantity" value="1"
                                min="1" max="@Model.StockAvailable"
                                class="w-20 border rounded-lg px-2 py-1 text-center focus:ring-2 focus:ring-pink-400" />
                            </div>
                            <button type="submit"
                            class="w-full px-4 py-2 bg-[#FF0090] text-white rounded-lg hover:bg-[#e60082] transition">
                                Add to Cart
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="mt-8 border-t pt-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Customer Reviews</h3>

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                @foreach (var review in Model.Reviews)
                {
                    <div class="flex items-start space-x-3 border-b pb-3 mb-3">
                        <img src="@(review.ProfileImage ?? "/images/default-profile.jpg")"
                             alt="@review.Username"
                             class="w-10 h-10 rounded-full object-cover" />

                        <div>
                            <p class="font-semibold text-gray-800">@review.Username</p>

                            <p class="text-yellow-500">
                                @((new string('★', review.Star)))
                                @((new string('☆', 5 - review.Star)))
                            </p>

                            <p class="text-sm text-gray-600">@review.Comment</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-gray-500">No reviews yet. Be the first to review this product!</p>
            }
        </div>

    </div>
</div>
