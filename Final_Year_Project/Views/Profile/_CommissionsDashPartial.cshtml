@model Final_Year_Project.Models.Profile.CommissionsDashViewModel

<section class="card shadow-md bg-base-100 mb-6">
    <div class="card-body">
        <div class="flex flex-col gap-4">
            <div class="flex justify-between items-center">
                <h2 class="text-xl font-bold">Commissions Summary</h2>
                <div class="flex gap-2 flex-wrap justify-end">
                    <button class="btn btn-sm btn-outline period-btn active" data-period="30">Last 30 Days</button>
                    <button class="btn btn-sm btn-outline period-btn" data-period="90">Last 90 Days</button>
                    <button class="btn btn-sm btn-outline period-btn" data-period="365">Last 365 Days</button>
                    <button class="btn btn-sm btn-outline period-btn" data-period="all">All Time</button>
                </div>
            </div>

            <canvas id="commissionsChart" class="w-full max-w-2xl mx-auto"></canvas>
        </div>
    </div>
</section>

<section class="card shadow-md bg-base-100 mb-6">
    <div class="card-body">
        <h2 class="text-xl font-bold mb-4">Totals</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="flex flex-col items-center justify-center p-4 bg-base-200 rounded-lg">
                <span class="text-sm text-gray-500 mb-2">Completed Requests</span>
                <span class="text-3xl font-bold text-primary" id="cd_totalCompleted">0</span>
            </div>
            <div class="flex flex-col items-center justify-center p-4 bg-base-200 rounded-lg">
                <span class="text-sm text-gray-500 mb-2">Total Revenue</span>
                <span class="text-3xl font-bold text-info" id="cd_totalRevenue">RM 0.00</span>
            </div>
            <div class="flex flex-col items-center justify-center p-4 bg-base-200 rounded-lg">
                <span class="text-sm text-gray-500 mb-2">Service Tax</span>
                <span class="text-3xl font-bold text-warning" id="cd_totalTax">RM 0.00</span>
            </div>
            <div class="flex flex-col items-center justify-center p-4 bg-base-200 rounded-lg">
                <span class="text-sm text-gray-500 mb-2">Total Earned</span>
                <span class="text-3xl font-bold text-success" id="cd_totalEarned">RM 0.00</span>
            </div>
        </div>
    </div>
</section>

<section class="card shadow-md bg-base-100">
    <div class="card-body">
        <div class="flex justify-between items-center flex-wrap gap-3 mb-4">
            <h2 class="text-xl font-bold">Completed Requests</h2>
            <div class="flex gap-2"></div>
        </div>

        <div id="requestsList" class="space-y-3 max-h-96 overflow-y-auto">
            <!-- Will be populated by JS -->
        </div>

        <div class="flex justify-center gap-2 mt-4">
            <button id="cd_prevBtn" class="btn btn-sm btn-outline" disabled>Previous</button>
            <div id="cd_pageInfo" class="flex items-center px-4">Page 1 of 1</div>
            <button id="cd_nextBtn" class="btn btn-sm btn-outline" disabled>Next</button>
        </div>
    </div>
</section>

<script>
    function safeJsonParse(json, fallback){
        try{
            if(typeof json === 'string') return JSON.parse(json);
            return json || fallback;
        }catch(e){ console.error(e); return fallback; }
    }

    const chartDataServer = safeJsonParse(@Html.Raw(Model.ChartData != null ? System.Text.Json.JsonSerializer.Serialize(Model.ChartData) : "null"), {"period30":{"labels":[],"values":[0,0,0,0]},"period90":{"labels":[],"values":[0,0,0,0]},"period365":{"labels":[],"values":[0,0,0,0]},"periodall":{"labels":[],"values":[0,0,0,0]}});

    const completedRequests = safeJsonParse(@Html.Raw(Model.CompletedRequests != null ? System.Text.Json.JsonSerializer.Serialize(Model.CompletedRequests) : "null"), []);

    console.log('Commissions chart data:', chartDataServer);
    console.log('Completed requests count:', completedRequests.length);

    let currentPeriod = '30';
    let currentPage = 1;
    const itemsPerPage = 10;
    let currentChart = null;

    function initCommissionsChart(){
        const canvas = document.getElementById('commissionsChart');
        if(!canvas) return;
        const ctx = canvas.getContext('2d');

        const periodKey = 'period' + currentPeriod;
        const pd = chartDataServer[periodKey] || {labels:[],values:[0,0,0,0]};

        const values = pd.values || [0,0,0,0];

        // convert values: first is integer count, others are currency numbers
        const dataValues = values.map(v => Number(v));
        
        // Only show currency data: Revenue, Service Tax, Total Earned
        const labels = ['Revenue', 'Service Tax', 'Total Earned'];
        const currencyData = [dataValues[1], dataValues[2], dataValues[3]];

        if(currentChart) currentChart.destroy();

        currentChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Amount (RM)',
                        data: currencyData,
                        backgroundColor: ['#0ea5e9','#f59e0b','#10b981'],
                        borderColor: ['#0284c7','#d97706','#059669'],
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: { 
                    legend: { display: false }
                },
                scales: {
                    y: { 
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return 'RM ' + value.toFixed(0);
                            }
                        }
                    }
                }
            }
        });

        // update totals display
        const count = dataValues[0] || 0;
        const revenue = dataValues[1] || 0;
        const tax = dataValues[2] || 0;
        const earned = dataValues[3] || 0;

        document.getElementById('cd_totalCompleted').textContent = count;
        document.getElementById('cd_totalRevenue').textContent = 'RM ' + Number(revenue).toFixed(2);
        document.getElementById('cd_totalTax').textContent = 'RM ' + Number(tax).toFixed(2);
        document.getElementById('cd_totalEarned').textContent = 'RM ' + Number(earned).toFixed(2);
    }

    function renderRequests(){
        const el = document.getElementById('requestsList');
        if(!el) return;
        el.innerHTML = '';

        const items = completedRequests || [];
        // sort by date desc
        items.sort((a,b)=> new Date(b.requestDate) - new Date(a.requestDate));

        const totalPages = Math.ceil(items.length / itemsPerPage) || 1;
        const start = (currentPage -1) * itemsPerPage;
        const pageItems = items.slice(start, start + itemsPerPage);

        if(pageItems.length === 0){
            const msg = items.length === 0 ? 'No completed requests' : 'No items on this page';
            el.innerHTML = '<div class="text-center py-8 text-gray-500">' + msg + '</div>';
        } else {
            pageItems.forEach(it => {
                const a = document.createElement('a');
                a.href = `/CommissionPlans/request/${it.RId}`;
                a.className = 'flex items-center gap-3 p-3 rounded-lg bg-base-200 hover:bg-base-300 transition cursor-pointer';

                const html = `
                    <div class="flex-1">
                        <div class="font-semibold">${it.PlanTitle || 'Commission'}</div>
                        <div class="text-sm text-gray-500">${it.ClientName || 'Client'} • ${new Date(it.RequestDate).toLocaleDateString()}</div>
                    </div>
                    <div class="text-right">
                        <div class="font-bold">RM ${Number(it.TotalAmount).toFixed(2)}</div>
                        <div class="text-xs text-gray-400">Tax RM ${Number(it.ServiceTax).toFixed(2)}</div>
                    </div>
                `;

                a.innerHTML = html;
                el.appendChild(a);
            });
        }

        document.getElementById('cd_pageInfo').textContent = `Page ${currentPage} of ${Math.max(1,totalPages)}`;
        document.getElementById('cd_prevBtn').disabled = currentPage <= 1;
        document.getElementById('cd_nextBtn').disabled = currentPage >= totalPages;
    }

    function setupListeners(){
        document.querySelectorAll('.period-btn').forEach(btn => {
            btn.addEventListener('click', function(){
                document.querySelectorAll('.period-btn').forEach(b=>b.classList.remove('active'));
                this.classList.add('active');
                currentPeriod = this.dataset.period;
                initCommissionsChart();
            });
        });

        document.getElementById('cd_prevBtn')?.addEventListener('click', ()=>{ if(currentPage>1){ currentPage--; renderRequests(); } });
        document.getElementById('cd_nextBtn')?.addEventListener('click', ()=>{ const total = Math.ceil((completedRequests||[]).length / itemsPerPage) || 1; if(currentPage < total){ currentPage++; renderRequests(); } });
    }

    if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', ()=>{ initCommissionsChart(); renderRequests(); setupListeners(); });
    else
        setTimeout(()=>{ initCommissionsChart(); renderRequests(); setupListeners(); }, 50);

    // small styling
    (function(){
        const css = '#commissionsChart{max-height:320px} .period-btn.active{background-color:var(--fallback-n,oklch(var(--n)));border-color:var(--fallback-n,oklch(var(--n)));color:var(--fallback-nc,oklch(var(--nc)))}';
        const s = document.createElement('style'); s.textContent = css; document.head.appendChild(s);
    })();
</script>
