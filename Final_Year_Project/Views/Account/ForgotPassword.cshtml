@model Final_Year_Project.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-rose-50 to-white">
    <div class="w-full max-w-md bg-white shadow-xl rounded-2xl p-8 border border-rose-100">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-primary">Forgot Password</h1>
            <p class="text-gray-600 mt-2">Enter your email to receive a reset link</p>
        </div>

        <!-- Alert Messages -->
        @{
            var alertClass = TempData["AlertClass"]?.ToString() ?? "";
        }
        @if (TempData["Info"] != null)
        {
            <div class="mb-6 p-4 rounded-xl border @(alertClass.Contains("success") ? "bg-green-50 border-green-200" : alertClass.Contains("danger") ? "bg-red-50 border-red-200" : "bg-blue-50 border-blue-200")">
                <p class="@(alertClass.Contains("success") ? "text-green-800" : alertClass.Contains("danger") ? "text-red-800" : "text-blue-800")">
                    @TempData["Info"]
                </p>
            </div>
        }

        <form asp-action="ForgotPassword" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-sm text-red-600"></div>
            
            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                <input asp-for="Email" type="email" placeholder="Enter your email address"
                       class="mt-2 w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-rose-400 focus:outline-none" />
                <span asp-validation-for="Email" class="text-sm text-red-600"></span>
            </div>

            <button type="submit"
                    class="w-full py-3 btn btn-primary text-white font-semibold rounded-xl">
                Send Reset Link
            </button>
        </form>

        <p class="text-center text-sm text-gray-500 mt-6">
            Remember your password?
            <a href="/Account/Login" class="text-primary hover:underline font-medium">Back to Login</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
