@model Final_Year_Project.Models.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<script>
    function togglePasswordVisibility(inputId, button) {
        const input = document.getElementById(inputId);
        // if called from inline onclick passing 'this', use that; otherwise fallback to event
        button = button || event?.currentTarget;
        const eyeIcon = button?.querySelector('.eye-icon');
        const eyeSlashIcon = button.querySelector('.eye-slash-icon');
        
        if (input.type === 'password') {
            input.type = 'text';
            eyeIcon.classList.add('hidden');
            eyeSlashIcon.classList.remove('hidden');
        } else {
            input.type = 'password';
            eyeIcon.classList.remove('hidden');
            eyeSlashIcon.classList.add('hidden');
        }
    }

    async function sendOtp() {
        const btn = document.getElementById('sendOtpBtn');
        const otpStatus = document.getElementById('otpStatus');
        const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
        
        if (!tokenElement) {
            otpStatus.classList.remove('hidden');
            otpStatus.className = 'text-red-500 text-sm mt-1';
            otpStatus.textContent = 'Security token not found. Please refresh the page.';
            return;
        }
        
        btn.disabled = true;
        btn.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Sending...';
        otpStatus.classList.add('hidden');
        
        try {
            const response = await fetch('/Account/send-change-password-otp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': tokenElement.value
                }
            });
            const data = await response.json();
            
            otpStatus.classList.remove('hidden');
            if (data.success) {
                otpStatus.className = 'text-green-600 text-sm mt-1';
                otpStatus.textContent = data.message;
                startCooldown(btn);
            } else {
                otpStatus.className = 'text-red-500 text-sm mt-1';
                otpStatus.textContent = data.message;
                btn.disabled = false;
                btn.innerHTML = 'Send OTP';
            }
        } catch (error) {
            otpStatus.classList.remove('hidden');
            otpStatus.className = 'text-red-500 text-sm mt-1';
            otpStatus.textContent = 'Failed to send OTP. Please try again.';
            btn.disabled = false;
            btn.innerHTML = 'Send OTP';
        }
    }
    
    function startCooldown(btn) {
        let seconds = 60;
        const interval = setInterval(() => {
            btn.innerHTML = `Resend in ${seconds}s`;
            seconds--;
            if (seconds < 0) {
                clearInterval(interval);
                btn.disabled = false;
                btn.innerHTML = 'Resend OTP';
            }
        }, 1000);
    }
</script>

<div class="min-h-screen flex items-center justify-center bg-base-200">
    <div class="w-full max-w-2xl">
        <!-- Header -->
        <div class="my-8">
            <h1 class="text-4xl font-bold text-gray-800 mt-4">Change Password</h1>
            <p class="text-gray-600 mt-2">Update your password securely</p>
        </div>

        <!-- Change Password Card -->
        <div class="bg-white shadow-md rounded-md p-8 mb-6">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Update Your Password</h2>

            <form method="post" asp-action="ChangePassword" class="space-y-6" asp-antiforgery="true">
                <!-- Current Password -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Current Password<span class="text-error">*</span></label>
                    <div class="relative">
                        <input asp-for="CurrentPassword" type="password"
                               class="w-full px-4 py-3 border border-gray-300 rounded-md focus:border-gray-500 focus:outline-none focus:ring-0 pr-10"
                               placeholder="Enter your current password" />
                        <button type="button" onclick="togglePasswordVisibility('CurrentPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none" tabindex="-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 eye-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 eye-slash-icon hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-red-500 text-sm mt-1 inline-block"></span>
                </div>

                <!-- OTP Code -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">OTP Code<span class="text-error">*</span></label>
                    <div class="flex gap-3">
                        <input asp-for="OtpCode" type="text" maxlength="6"
                               class="flex-1 px-4 py-3 border border-gray-300 rounded-md focus:border-gray-500 focus:outline-none focus:ring-0"
                               placeholder="Enter 6-digit OTP" />
                        <button type="button" id="sendOtpBtn" onclick="sendOtp()" 
                                class="px-4 py-3 btn btn-outline font-semibold rounded-md hover:bg-gray-100 transition whitespace-nowrap">
                            Send OTP
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Click "Send OTP" to receive a verification code in your email</p>
                    <span id="otpStatus" class="hidden"></span>
                    <span asp-validation-for="OtpCode" class="text-red-500 text-sm mt-1 inline-block"></span>
                </div>

                <!-- New Password -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">New Password<span class="text-error">*</span></label>
                    <div class="relative">
                           <input asp-for="NewPassword" type="password"
                               class="w-full px-4 py-3 border border-gray-300 rounded-md focus:border-gray-500 focus:outline-none focus:ring-0 pr-10"
                               placeholder="Enter new password" />
                        <button type="button" onclick="togglePasswordVisibility('NewPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none" tabindex="-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 eye-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 eye-slash-icon hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                            </svg>
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Must contain uppercase, lowercase, and digit (8-30 characters)</p>
                    <span asp-validation-for="NewPassword" class="text-red-500 text-sm mt-1 inline-block"></span>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Confirm Password<span class="text-error">*</span></label>
                    <div class="relative">
                           <input asp-for="ConfirmPassword" type="password"
                               class="w-full px-4 py-3 border border-gray-300 rounded-md focus:border-gray-500 focus:outline-none focus:ring-0 pr-10"
                               placeholder="Confirm new password" />
                        <button type="button" onclick="togglePasswordVisibility('ConfirmPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 focus:outline-none" tabindex="-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 eye-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 eye-slash-icon hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm mt-1 inline-block"></span>
                </div>

                <!-- Buttons -->
                <div class="flex gap-3 pt-4">
                    <button type="submit" class="flex-1 py-3 btn btn-primary text-white font-semibold rounded-xl hover:shadow-lg transition">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        Update Password
                    </button>
                    <a href="/Account/setting" class="flex-1 py-3 btn btn-outline font-semibold rounded-xl hover:bg-gray-100 transition text-center flex items-center justify-center gap-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

        <!-- Security Tips Card -->
        <div class="bg-white shadow-md rounded-md p-8">
            <h3 class="text-xl font-bold text-gray-800 mb-4">Password Security Tips</h3>
            <ul class="space-y-2 text-gray-700">
                <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Use a strong password with uppercase, lowercase, and numbers</span>
                </li>
                <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Don't share your password with anyone</span>
                </li>
                <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Use a different password than other websites</span>
                </li>
                <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Change your password regularly</span>
                </li>
            </ul>
        </div>
    </div>
</div>
