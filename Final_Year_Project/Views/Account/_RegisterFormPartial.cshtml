@model Final_Year_Project.Models.Account.RegisterViewModel

<form asp-action="Register" method="post" class="space-y-6">

    <input type="hidden" asp-for="Role" />

    <div>
        <input asp-for="Username" placeholder="Username"
               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-rose-400 focus:outline-none" />
        <span asp-validation-for="Username" class="text-red-500 text-sm"></span>
    </div>

    <div>
        <input asp-for="Name" placeholder="Full Name"
               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-rose-400 focus:outline-none" />
        <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
    </div>

    @if (Model.Role == "artist")
    {
        <div>
            <input asp-for="Nickname" placeholder="Artist Nickname"
                   class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-rose-400 focus:outline-none" />
            <span asp-validation-for="Nickname" class="text-red-500 text-sm"></span>
        </div>
    }

    <div>
        <input asp-for="Email" type="email" placeholder="Email"
               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-rose-400 focus:outline-none" />
        <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
    </div>

    <div>
        <input asp-for="PhoneNumber" placeholder="Phone Number"
               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-rose-400 focus:outline-none" />
        <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
    </div>

    <div>
        <select asp-for="Gender"
                class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-white focus:ring-2 focus:ring-rose-400 focus:outline-none">
            <option value="">-- Select Gender --</option>
            <option>male</option>
            <option>female</option>
        </select>
        <span asp-validation-for="Gender" class="text-red-500 text-sm"></span>
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>

        <div class="relative">
            <input id="password" asp-for="Password" type="password" placeholder="Password"
                   class="mt-2 w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-rose-400 focus:outline-none pr-12" />

            <button type="button"
                    onclick="togglePassword('password', 'eyeIcon', 'eyeSlashIcon')"
                    class="absolute inset-y-0 right-3 flex items-center text-gray-500 hover:text-gray-700">

                <!-- Eye -->
                <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20" fill="currentColor"
                     class="bi bi-eye-fill">
                    <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0" />
                    <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7" />
                </svg>

                <!-- Eye Slash -->
                <svg id="eyeSlashIcon" xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20" fill="currentColor"
                     class="bi bi-eye-slash-fill hidden">
                    <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278
                         0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21
                         3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939
                         1.721-2.641 3.238l-2.062-2.062a3.5 3.5
                         0 0 0-4.474-4.474z" />
                    <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5
                         2.5 0 0 1 2.829 2.829zm3.171 6-12-12
                         .708-.708 12 12z" />
                </svg>

            </button>
        </div>

        <p class="text-xs text-gray-500 mt-1">
            • 8–30 characters<br>
            • Must contain uppercase, lowercase, and digit
        </p>

        <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
    </div>


    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
        <div class="relative">
            <input asp-for="ConfirmPassword" id="confirmPassword" type="password" placeholder="Confirm Password"
                   class="w-full px-4 py-3 pr-12 border border-gray-300 rounded-xl focus:ring-2 focus:ring-rose-400 focus:outline-none" />

            <button type="button"
                    onclick="togglePassword('confirmPassword', 'eyeConfirm', 'eyeSlashConfirm')"
                    class="absolute inset-y-0 right-3 flex items-center text-gray-500 hover:text-gray-700">

                <svg id="eyeConfirm" xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20" fill="currentColor"
                     class="bi bi-eye-fill">
                    <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0" />
                    <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7" />
                </svg>

                <svg id="eyeSlashConfirm" xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20" fill="currentColor"
                     class="bi bi-eye-slash-fill hidden">
                    <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278
                     0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21
                     3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939
                     1.721-2.641 3.238l-2.062-2.062a3.5 3.5
                     0 0 0-4.474-4.474z" />
                    <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5
                     2.5 0 0 1 2.829 2.829zm3.171 6-12-12
                     .708-.708 12 12z" />
                </svg>

            </button>
        </div>

        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
    </div>

    <button type="submit"
            class="w-full py-3 bg-primary text-white font-semibold rounded-xl hover:bg-rose-500 transition">
        Register
    </button>

</form>