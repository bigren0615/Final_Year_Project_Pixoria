@using Final_Year_Project.Models.OrderHistory
@using Final_Year_Project.Enums
@model OrderHistoryViewModel

<div class="max-w-5xl mx-auto px-4 py-10">
    <h2 class="text-3xl font-semibold text-gray-800 mb-6 border-b pb-2">Order History</h2>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded mb-4">
            @TempData["Info"]
        </div>
    }

    <form method="get" class="flex flex-wrap gap-3 items-center mb-6">
        <select name="order_status"
                class="border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            <option value="">All</option>

            @foreach (orderStatus status in Enum.GetValues(typeof(orderStatus)))
            {
                var value = status.ToString().ToLower(); 
                var display = status.ToString().ToUpper();
                <option value="@value" selected="@(Model.SelectedStatus == value)">
                    @display
                </option>
            }
        </select>

        <button type="submit"
                class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition">
            Filter
        </button>
    </form>

    @if (Model.Orders.Any())
    {
        var hasShownPendingHeader = false;
        var hasShownOtherHeader = false;

        <div class="space-y-6">
            @foreach (var order in Model.Orders)
            {
                bool isPending = order.PaymentStatus?.ToLower() == "pending";

                if (isPending && !hasShownPendingHeader)
                {
                    hasShownPendingHeader = true;
                    <h3 class="text-xl font-semibold text-yellow-600 mb-2 border-b border-yellow-200 pb-1">Pending Orders</h3>
                }

                if (!isPending && !hasShownOtherHeader)
                {
                    hasShownOtherHeader = true;
                    <h3 class="text-xl font-semibold text-gray-700 mt-8 mb-2 border-b border-gray-200 pb-1">Other Orders</h3>
                }

            <div class="border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition bg-white">
                <div class="flex justify-between items-center bg-gray-50 px-5 py-3 rounded-t-xl">
                    <p class="text-gray-700 font-medium">
                        #@order.OId • Ordered on @order.OrderDateTime.ToString("dd MMM yyyy")
                    </p>
                    <span class="text-sm font-semibold px-3 py-1 rounded-full
                            @(order.PaymentStatus == "paid" && order.DeliveryStatus == "delivered" ? "bg-green-100 text-green-700" :
                              order.PaymentStatus == "paid" ? "bg-blue-100 text-blue-700" :
                              order.PaymentStatus == "pending" ? "bg-yellow-100 text-yellow-700" :
                              order.PaymentStatus == "cancelled" ? "bg-red-100 text-red-700" :
                              "bg-gray-100 text-gray-700")">
                    @order.PaymentStatus.ToUpper()
                </span>
            </div>

                    <a href="/Profile/OrderHistory/OrderDetail?OId=@order.OId" class="block">
                        <div class="divide-y divide-gray-100">
                    @foreach (var item in Model.OrderItems[order.OId])
                            {
                                <div class="flex items-center gap-4 p-4">
                                    <img src="@item.Image"
                                         class="w-20 h-20 object-cover rounded-lg border" alt="@item.ArtworkName" />
                                    <div class="flex-1">
                                        <p class="font-medium text-gray-800">@item.ArtworkName</p>
                                        <p class="text-sm text-gray-500">x @item.Unit</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="font-semibold text-gray-800">
                                            RM @item.Subtotal.ToString("0.00")
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    </a>

                    <div class="flex justify-between items-center px-5 py-3 bg-gray-50 rounded-b-xl">
                        <p class="text-gray-700">
                            <span class="font-medium">Order total:</span>
                            <span class="text-lg font-semibold text-indigo-600">
                                RM @order.TotalAmount.ToString("0.00")
                            </span>
                        </p>

                        <div>
                            @if (order.PaymentStatus == "delivered" || order.PaymentStatus == "cancelled" || order.PaymentStatus == "failed")
                            {
                                <button class="bg-gray-800 text-white px-4 py-2 rounded-lg hover:bg-gray-900 transition">
                                    Buy Again
                                </button>
                            }
                            else if (order.PaymentStatus == "pending")
                            {
                                <form asp-action="PayExistingOrder" asp-controller="Payment" method="post" class="inline-block">
                                    <input type="hidden" name="orderId" value="@order.OId" />
                                    <input type="hidden" name="total" value="@order.TotalAmount" />

                                    <button type="submit"
                                            class="bg-yellow-600 hover:bg-yellow-700 text-white px-6 py-2 rounded-lg font-medium transition">
                                        Pay Now
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-10">
            <h3 class="text-xl font-medium text-gray-600">You do not have any orders</h3>
        </div>
    }
</div>
