@model Final_Year_Project.Models.OrderHistory.OrderDetailViewModel

@{
    var steps = new List<(string Key, string Label, string Icon)>
    {
        ("pending", "1. Order Placed",
            @"<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
                d='M9 14h6m-6-4h6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h6l6 6v10a2 2 0 01-2 2z'/>"),

        ("paid", "2. Payment Received",
            @"<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
                d='M3 10h18M3 6h18a2 2 0 012 2v8a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2z'/>"),

        ("processing", "3. Processing Order",
            @"<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
                d='M4 4h16M4 8h16M4 12h16M4 16h16M4 20h16'/>"),

        ("packed", "4. Packed & Ready",
            @"<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
                d='M3 7l9-4 9 4v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7z'/>"),

        ("shipping", "5. Shipping",
            @"<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
                d='M3 13V6a1 1 0 011-1h10v5h4l3 3v6h-3a2 2 0 11-4 0H9a2 2 0 11-4 0H3v-6z'/>"),

        ("delivered", "6. Delivered",
            @"<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
                d='M5 13l4 4L19 7'/>")
    };

    string payment = Model.Order.PaymentStatus?.Trim().ToLower() ?? "pending";
    string delivery = Model.Order.DeliveryStatus?.Trim().ToLower() ?? "pending";

    string currentStatus = "pending";

    if (payment == "paid") currentStatus = "paid";
    if (delivery == "packed") currentStatus = "packed";
    if (delivery == "shipped") currentStatus = "shipping";
    if (delivery == "delivered") currentStatus = "delivered";

    int currentIndex = steps.FindIndex(s => s.Key == currentStatus);
    if (currentIndex < 0) currentIndex = 0;

    string progressWidth = ((currentIndex) * (100 / (steps.Count - 1))) + "%";

    var userReviews = ViewData["UserReviews"] as List<string> ?? new List<string>();
    var refundRequests = ViewData["RefundRequests"] as Dictionary<long, Final_Year_Project.Models.DB.Refund> ?? new Dictionary<long, Final_Year_Project.Models.DB.Refund>();

    // Calculate refund due date (7 days after delivery)
    DateTime? refundDueDate = null;
    if (Model.Order.DeliveryDateTime.HasValue)
    {
        refundDueDate = Model.Order.DeliveryDateTime.Value.AddDays(7);
    }
    bool canRequestRefund = refundDueDate.HasValue && DateTime.UtcNow <= refundDueDate;

    var totalAmount = Model.Order.TotalAmount;
    var subtotal = totalAmount / 1.16;

    var serviceTax = subtotal * 0.10;
    var sst = subtotal * 0.06;
}
<div class="max-w-5xl mx-auto px-6 py-8">
    <div class="flex justify-between items-center mb-6">
        <a href="/Profile/OrderHistory" class="flex items-center text-gray-600 hover:text-gray-900 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Back to Order History</span>
        </a>
    </div>

    <div class="relative mb-12">
        <div class="absolute top-6 left-[5%] w-[90%] h-[3px] bg-gray-300 z-0">
            <div class="h-[3px] bg-green-500 transition-all duration-700 ease-in-out"
                 style="width:@progressWidth"></div>
        </div>

        <div class="flex justify-between items-start z-10">
            @for (int i = 0; i < steps.Count; i++)
            {
                bool active = i <= currentIndex;

                <div class="flex flex-col items-center text-center w-full">
                    <div class="w-12 h-12 flex items-center justify-center rounded-full border-4
                        @(active ? "border-green-500 bg-green-50" : "border-gray-300 bg-gray-50")">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-6 h-6 @(active ? "text-green-600" : "text-gray-400")"
                             fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            @Html.Raw(steps[i].Icon)
                        </svg>
                    </div>

                    <p class="mt-3 font-semibold">@steps[i].Label</p>

                    <p class="text-xs text-gray-500">
                        @{
                            string dateText = steps[i].Key switch
                            {
                                "pending" => Model.Order.OrderDateTime.ToString("yyyy-MM-dd HH:mm:ss"),
                                "paid" => Model.Order.PaymentDateTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-",
                                "packed" => Model.Order.DeliveryDateTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-",
                                "shipping" => Model.Order.DeliveryDateTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-",
                                "delivered" => Model.Order.DeliveryDateTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-",
                                _ => "-"
                            };
                        }
                        @dateText
                    </p>

                </div>
            }
        </div>
    </div>

    @* Refund Deadline Notice *@
    @if (Model.Order.DeliveryStatus?.Trim().ToLower() == "delivered" && refundDueDate.HasValue)
    {
        if (canRequestRefund)
        {
            <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-lg mb-6">
                <div class="flex items-center">
                    <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                    </svg>
                    <strong>Refund Available</strong>
                </div>
                <p class="mt-2 text-sm">If the product is damaged or not as described, you can request a refund before <strong>@refundDueDate.Value.ToString("MMMM dd, yyyy")</strong>.</p>
            </div>
        }
        else
        {
            <div class="bg-gray-50 border border-gray-200 text-gray-600 px-4 py-3 rounded-lg mb-6">
                <div class="flex items-center">
                    <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                    <strong>Refund Period Expired</strong>
                </div>
                <p class="mt-2 text-sm">The refund deadline expired on @refundDueDate.Value.ToString("MMMM dd, yyyy").</p>
            </div>
        }
    }

    <div class="border-t pt-4 mb-6">
        <h3 class="font-semibold mb-2">Delivery Address</h3>
        <p class="text-gray-700">@Model.Username</p>
        <p class="text-gray-700">@Model.Order.Address</p>
    </div>

    <div class="space-y-6">

        @if (Model.Order.DeliveryStatus?.Trim().ToLower() == "shipped")
        {
            <div class="mt-6 text-center">
                <form method="post" asp-action="ConfirmDelivered" asp-route-OId="@Model.Order.OId">
                    <button type="submit"
                            class="px-5 py-2 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition">
                        I Received My Order
                    </button>
                </form>
            </div>
        }
        @foreach (var item in Model.Items)
        {
            <div class="flex items-center bg-white shadow-md rounded-xl p-4 border hover:shadow-lg transition-all">

                <img src="@item.Image"
                     class="w-20 h-20 object-cover rounded-lg border mr-4" />

                <div class="flex-1">
                    <p class="font-semibold text-gray-800 text-lg">@item.ArtworkName</p>
                    <p class="text-sm text-gray-500 mt-1">
                        Quantity: <span class="font-medium">@item.Unit</span>
                    </p>
                    <p class="text-md font-semibold text-gray-900 mt-1 block md:hidden">
                        RM @item.Subtotal.ToString("0.00")
                    </p>
                </div>

                <div class="hidden md:block text-right mr-4">
                    <p class="text-lg font-semibold text-gray-900">
                        RM @item.Subtotal.ToString("0.00")
                    </p>
                </div>

                @if (Model.Order.DeliveryStatus?.Trim().ToLower() == "delivered")
                {
                    <div class="ml-3 flex flex-col space-y-2">
                        @if (userReviews.Contains(item.PId))
                        {
                            <span class="px-4 py-2 bg-gray-300 text-gray-600 text-sm font-medium rounded-lg text-center">
                                Already Reviewed
                            </span>
                        }
                        else
                        {
                            <a href="/Profile/OrderHistory/ReviewProduct?PId=@item.PId"
                               class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg text-center
                                          hover:bg-blue-700 active:scale-95 transition-all shadow-sm">
                                Write Review
                            </a>
                        }

                        @* Refund Button *@
                        @if (item.OrderItemId.HasValue && refundRequests.ContainsKey(item.OrderItemId.Value))
                        {
                            var refund = refundRequests[item.OrderItemId.Value];
                            var refundStatusColor = refund.RefundStatus switch
                            {
                                "pending" => "bg-yellow-100 text-yellow-700 border-yellow-300",
                                "approved" => "bg-green-100 text-green-700 border-green-300",
                                "rejected" => "bg-red-100 text-red-700 border-red-300",
                                "completed" => "bg-blue-100 text-blue-700 border-blue-300",
                                _ => "bg-gray-100 text-gray-700 border-gray-300"
                            };

                            <span class="px-4 py-2 text-sm font-medium rounded-lg border @refundStatusColor text-center">
                                Refund: @refund.RefundStatus.ToUpper()
                            </span>
                        }
                        else if (canRequestRefund)
                        {
                            <a href="@Url.Action("RequestRefund", "Refund", new { orderItemId = item.OrderItemId })"
                               class="px-4 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg text-center
                                          hover:bg-orange-700 active:scale-95 transition-all shadow-sm">
                                Request Refund
                            </a>
                        }
                        else if (refundDueDate.HasValue)
                        {
                            <span class="px-4 py-2 bg-gray-200 text-gray-600 text-sm font-medium rounded-lg text-center cursor-not-allowed"
                                  title="Refund deadline expired on @refundDueDate.Value.ToString("MMM dd, yyyy")">
                                Refund Expired
                            </span>
                        }
                    </div>
                }
            </div>
        }
    </div>
    <div class="mt-6 bg-gray-50 p-4 rounded-lg shadow-sm">
        <h3 class="font-semibold text-lg mb-3">Payment Summary</h3>

        <div class="flex justify-between text-gray-700 mb-1">
            <span>Subtotal:</span>
            <span>RM @subtotal.ToString("0.00")</span>
        </div>

        <div class="flex justify-between text-gray-700 mb-1">
            <span>Service Tax 10%:</span>
            <span>RM @serviceTax.ToString("0.00")</span>
        </div>

        <div class="flex justify-between text-gray-700 mb-3">
            <span>SST 6%:</span>
            <span>RM @sst.ToString("0.00")</span>
        </div>

        <div class="flex justify-between font-bold text-indigo-700 text-lg border-t pt-3">
            <span>Grand Total:</span>
            <span>RM @totalAmount.ToString("0.00")</span>
        </div>
    </div>

</div>
