@model Final_Year_Project.Models.Sales.ArtistProductDetailsViewModel

@{
    var mainImage = Model.PrimaryImage ?? "/images/no-image.png";
}

<div class="min-h-screen bg-gray-50 p-6 flex justify-center">

    <div class="w-full max-w-5xl bg-white shadow-xl rounded-2xl p-6">

        <div class="flex justify-between items-center mb-4">
            <a href="@Url.Action("MyProduct", "Sales")"
               class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700">
                ← Back to My Products
            </a>

            <div class="flex gap-3">
                <a href="@Url.Action("EditProduct", "Sales", new { id = Model.PId })"
                   class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                    Edit Product
                </a>

                <a href="@Url.Action("ViewArtworkDetails", "Purchase", new { id = Model.PId })"
                   class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">
                    View Public Page
                </a>

                <form asp-action="DeleteProduct"
                      asp-controller="Sales"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to delete this product?');">

                    <input type="hidden" name="id" value= @Model.PId />

                    <button type="submit"
                            class="p-2 bg-base-200 text-gray rounded hover:bg-red-600 transition flex items-center justify-center"
                            title="Delete Product">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 25 25"
                             stroke-width="1.5"
                             class="w-5 h-5">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M6 1h13v1H6zM23 3H2v1h2v18.5A1.502 1.502 0 0 0 5.5 24h14a1.502 1.502 0 0 0 1.5-1.5V4h2zM9 20H8V7h1zm4 0h-1V7h1zm4 0h-1V7h1z" />
                        </svg>
                    </button>
                </form>

            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div>
                <div class="w-full h-96 bg-gray-100 rounded-xl flex justify-center items-center overflow-hidden">
                    <img id="mainImage"
                         src="@mainImage"
                         class="w-full h-full object-cover rounded-xl" />
                </div>

                <div class="flex gap-2 mt-3 overflow-x-auto">
                    @foreach (var img in Model.Images)
                    {
                        <img src="@img"
                             onclick="document.getElementById('mainImage').src=this.src"
                             class="w-20 h-20 rounded-lg object-cover cursor-pointer border hover:ring-2 hover:ring-pink-500 transition" />
                    }
                </div>
            </div>

            <div>
                <h2 class="text-3xl font-bold text-gray-800">@Model.ProductName</h2>

                <p class="mt-3 text-gray-700">@Model.Description</p>

                <p class="mt-3 text-xl font-semibold text-pink-600">
                    RM @Model.Price.ToString("0.00")
                </p>

                <p class="mt-2 text-gray-800">
                    Stock:
                    <span class="font-semibold">@Model.StockAvailable</span>
                </p>

                <p class="mt-2">
                    @switch (Model.Status)
                    {
                        case "available":
                            <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-semibold">Available</span>
                            break;
                        case "unlisted":
                            <span class="bg-gray-200 text-gray-700 px-3 py-1 rounded-full text-sm font-semibold">Unlisted</span>
                            break;
                        case "outOfStock":
                            <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-semibold">Out of Stock</span>
                            break;
                        case "discontinued":
                            <span class="bg-gray-300 text-gray-700 px-3 py-1 rounded-full text-sm font-semibold">Discontinued</span>
                            break;
                    }
                </p>

                <p class="mt-3 text-gray-700">
                    Category:
                    <span class="font-semibold">@Model.CategoryName</span>
                </p>

                <p class="mt-1 text-gray-700">
                    Subcategory:
                    <span class="font-semibold">@Model.SubCategoryName</span>
                </p>

                <div class="mt-5 text-sm text-gray-500">
                    <p>Created: @Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</p>
                </div>
            </div>
        </div>
    </div>
</div>
