@{
    var currentPath = Context.Request.Path.Value?.ToLower();
}

<aside class="w-64 bg-white border-r flex flex-col">
    <div class="p-6 border-b">
        <h2 class="text-2xl font-bold text-pink-500">Seller Center</h2>
        <p class="text-sm text-gray-500">Manage your shop efficiently</p>
    </div>

    <nav class="flex-1 px-4 py-6 space-y-1">
        <a href="/Sales/MainSellerCenter"
           class="flex items-center gap-3 p-3 rounded-lg transition text-gray-700 hover:bg-gray-100">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h18v18H3V3z" />
            </svg>
            Dashboard
        </a>

        <a href="/Sales/MyProduct"
           class="flex items-center gap-3 p-3 rounded-lg transition text-gray-700 hover:bg-gray-100">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
