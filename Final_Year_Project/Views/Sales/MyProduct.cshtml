@model IEnumerable<Final_Year_Project.Models.Sales.SellerProductViewModel>

@{
    ViewData["Title"] = "My Products";
}

<div class="flex min-h-screen bg-gray-50">
    @await Html.PartialAsync("_SellerCenterSidebar")

    <main class="flex-1 p-8 overflow-y-auto">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-3xl font-bold text-gray-800">My Products</h1>

            <div class="flex gap-3">
                <a href="@Url.Action("AddProduct", "Sales")"
                   class="block text-center w-full px-4 py-2 bg-pink-500 text-white font-medium rounded-lg hover:bg-pink-600 transition">
                    + Add Product
                </a>

                <button id="cardViewBtn"
                        class="p-2 bg-pink-500 text-white rounded-lg hover:bg-pink-600 transition"
                        title="Card View">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M3 3h7v7H3V3zm11 0h7v7h-7V3zM3 14h7v7H3v-7zm11 0h7v7h-7v-7z" />
                    </svg>
                </button>

                <button id="gridViewBtn"
                        class="p-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition"
                        title="Grid View">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M3 5h18M3 10h18M3 15h18M3 20h18" />
                    </svg>
                </button>
            </div>
        </div>

        <div id="productContainer">
            @await Html.PartialAsync("_MyProductCardView", Model)
        </div>
    </main>
</div>

@section Scripts {
    <script>
        const gridBtn = document.getElementById("gridViewBtn");
        const cardBtn = document.getElementById("cardViewBtn");
        const container = document.getElementById("productContainer");

        function setActiveButton(active, inactive) {
            active.classList.remove("bg-gray-200", "text-gray-700", "hover:bg-gray-300");
            active.classList.add("bg-pink-500", "text-white", "hover:bg-pink-600");
            inactive.classList.remove("bg-pink-500", "text-white", "hover:bg-pink-600");
            inactive.classList.add("bg-gray-200", "text-gray-700", "hover:bg-gray-300");
        }

        cardBtn.addEventListener("click", async () => {
            const res = await fetch(`/Sales/MyProduct?viewType=card`, {
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            container.innerHTML = await res.text();
            setActiveButton(cardBtn, gridBtn);
        });

        gridBtn.addEventListener("click", async () => {
            const res = await fetch(`/Sales/MyProduct?viewType=grid`, {
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            container.innerHTML = await res.text();
            setActiveButton(gridBtn, cardBtn);
        });

        setActiveButton(cardBtn, gridBtn);
    </script>
}

