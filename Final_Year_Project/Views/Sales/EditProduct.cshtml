@model Final_Year_Project.Models.Sales.ProductAddEditViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="flex min-h-screen bg-gray-50">
    <div class="flex-1 p-8 overflow-y-auto">
        <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-lg p-8">
            <h1 class="text-3xl font-bold mb-6 text-gray-800">Edit Product</h1>

            <form asp-action="EditProduct" asp-controller="Sales" method="post" enctype="multipart/form-data" class="space-y-6">
                <input type="hidden" asp-for="ProductId" />

                <div>
                    <label asp-for="Name" class="block text-gray-700 font-medium mb-2">Product Name</label>
                    <input asp-for="Name" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-pink-400 focus:outline-none" />
                    <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-gray-700 font-medium mb-2">Current Category</label>
                        <input type="text"
                               class="w-full border border-gray-300 bg-gray-100 rounded-lg p-3"
                               value="@Model.CategoryList.FirstOrDefault(c => c.Value == Model.CatId.ToString())?.Text"
                               readonly />
                    </div>

                    <div>
                        <label class="block text-gray-700 font-medium mb-2">Current Subcategory</label>
                        <input type="text"
                               class="w-full border border-gray-300 bg-gray-100 rounded-lg p-3"
                               value="@Model.SubCategoryList.FirstOrDefault(sc => sc.Value == Model.SubCatId.ToString())?.Text"
                               readonly />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-gray-700 font-medium mb-2">Change Category (Optional)</label>
                        <select id="NewCatId" name="NewCatId" class="w-full border rounded-lg p-2">
                            <option value="">-- Select New Category --</option>
                            @foreach (var item in Model.CategoryList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-gray-700 font-medium mb-2">Change Subcategory (Optional)</label>
                        <select id="NewSubCatId" name="NewSubCatId" class="w-full border rounded-lg p-2">
                            <option value="">-- Select New Subcategory --</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Price" class="block text-gray-700 font-medium mb-2">Price (RM)</label>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-pink-400" />
                        <span asp-validation-for="Price" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="ShippingFee" class="block text-gray-700 font-medium mb-2">Shipping Fee (RM)</label>
                        <input asp-for="ShippingFee" type="number" step="0.01" min="0" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-pink-400" />
                        <span asp-validation-for="ShippingFee" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="StockAvailable" class="block text-gray-700 font-medium mb-2">Stock Available</label>
                    <input asp-for="StockAvailable" type="number" min="1" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-pink-400" />
                    <span asp-validation-for="StockAvailable" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Description" class="block text-gray-700 font-medium mb-2">Description</label>
                    <textarea asp-for="Description" rows="4" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-pink-400"></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label class="block text-gray-700 font-medium mb-2">Product Images</label>

                    <input asp-for="Images" id="imageInput" type="file" multiple accept="image/*"
                           class="w-full border border-gray-300 rounded-lg p-3 bg-gray-50 focus:ring-2 focus:ring-pink-400 focus:outline-none" />
                    <p class="text-gray-500 text-sm mt-1">You can upload up to 5 images.</p>

                    <div id="imagePreview" class="flex flex-wrap gap-4 mt-4"></div>

                    <div id="existingImages" class="flex flex-wrap gap-4 mt-4">
                        @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                        {
                            foreach (var img in Model.ExistingImages)
                            {
                                var isPrimary = img.IsPrimary ? "ring-4 ring-pink-500" : "";
                                <div class="relative inline-block group image-wrapper">
                                    <img src="@img.ImagePath"
                                         class="w-32 h-32 object-cover rounded-lg shadow-md cursor-pointer @isPrimary"
                                         data-imagepath="@img.ImagePath" />
                                    <div class="absolute bottom-1 left-1 bg-pink-500 text-white text-xs px-2 py-0.5 rounded
                                        @(img.IsPrimary ? "" : "hidden")">
                                        Primary
                                    </div>
                                    <button type="button"
                                            class="absolute top-0 right-0 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center shadow-md hover:bg-red-600 cursor-pointer existing-image-remove">
                                        ×
                                    </button>
                                    <input type="hidden" name="KeepImages" value="@img.ImagePath" />
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-gray-500">No images uploaded yet.</p>
                        }
                    </div>

                    <input type="hidden" id="selectedPrimary" name="PrimaryImage"
                           value="@(Model.ExistingImages?.FirstOrDefault(i => i.IsPrimary)?.ImagePath ?? "")" />
                </div>

                <div>
                    <label asp-for="Status" class="block text-gray-700 font-medium mb-2">Status</label>
                    <select asp-for="Status" asp-items="ViewBag.StatusList" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-pink-400">
                    </select>
                    <span asp-validation-for="Status" class="text-red-500 text-sm"></span>
                </div>

                <div class="mt-8 flex justify-between">
                    <a href="@Url.Action("MyProduct", "Sales")"
                       class="px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition">
                        Cancel
                    </a>
                    <button type="submit"
                            class="bg-pink-500 hover:bg-pink-600 text-white font-medium px-6 py-2 rounded-lg transition">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const imageInput = document.getElementById("imageInput");
            const preview = document.getElementById("imagePreview");
            const existingContainer = document.getElementById("existingImages");
            const primaryInput = document.getElementById("selectedPrimary");
            const categorySelect = document.getElementById("NewCatId");
            const subcategorySelect = document.getElementById("NewSubCatId");

            categorySelect?.addEventListener("change", function() {
                const catId = this.value;
                
                subcategorySelect.innerHTML = '<option value="">-- Select New Subcategory --</option>';
                
                if (!catId) {
                    return;
                }
                
                fetch(`@Url.Action("GetSubCategories", "Sales")?catId=${catId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.error) {
                            console.error(data.error);
                            return;
                        }
                        
                        data.forEach(subcat => {
                            const option = document.createElement("option");
                            option.value = subcat.value;
                            option.textContent = subcat.text;
                            subcategorySelect.appendChild(option);
                        });
                    })
                    .catch(error => {
                        console.error("Error loading subcategories:", error);
                    });
            });

            existingContainer?.addEventListener("click", (e) => {
                const clickedImg = e.target.closest("img");
                if (!clickedImg) return;

                existingContainer.querySelectorAll("img").forEach(img => {
                    img.classList.remove("ring-4", "ring-pink-500");
                    img.nextElementSibling?.classList.add("hidden");
                });

                clickedImg.classList.add("ring-4", "ring-pink-500");
                clickedImg.nextElementSibling?.classList.remove("hidden");
                primaryInput.value = clickedImg.dataset.imagepath;
            });

            imageInput?.addEventListener("change", () => {
                preview.innerHTML = "";
                const files = Array.from(imageInput.files);

                files.forEach((file, index) => {
                    if (!file.type.startsWith("image/")) return;

                    const reader = new FileReader();
                    reader.onload = e => {
                        const wrapper = document.createElement("div");
                        wrapper.classList.add("relative", "inline-block", "group");

                        const img = document.createElement("img");
                        img.src = e.target.result;
                        img.classList.add("w-32", "h-32", "object-cover", "rounded-lg", "shadow-md", "cursor-pointer");

                        const badge = document.createElement("div");
                        badge.textContent = "Primary";
                        badge.classList.add("absolute", "bottom-1", "left-1",
                            "bg-pink-500", "text-white", "text-xs", "px-2", "py-0.5", "rounded", "hidden");

                        const removeBtn = document.createElement("button");
                        removeBtn.innerHTML = "×";
                        removeBtn.classList.add(
                            "absolute", "top-0", "right-0",
                            "bg-red-500", "text-white", "rounded-full",
                            "w-6", "h-6", "flex", "items-center",
                            "justify-center", "shadow-md", "hover:bg-red-600", "cursor-pointer"
                        );

                        img.addEventListener("click", () => {
                            preview.querySelectorAll(".ring-4").forEach(el => {
                                el.classList.remove("ring-4", "ring-pink-500");
                                el.nextSibling?.classList.add("hidden");
                            });
                            img.classList.add("ring-4", "ring-pink-500");
                            badge.classList.remove("hidden");
                            primaryInput.value = file.name;
                        });

                        removeBtn.addEventListener("click", () => {
                            wrapper.remove();
                            const newFiles = files.filter((_, i) => i !== index);
                            const dataTransfer = new DataTransfer();
                            newFiles.forEach(f => dataTransfer.items.add(f));
                            imageInput.files = dataTransfer.files;
                            imageInput.dispatchEvent(new Event("change"));
                        });

                        wrapper.appendChild(img);
                        wrapper.appendChild(badge);
                        wrapper.appendChild(removeBtn);
                        preview.appendChild(wrapper);

                        if (index === 0) {
                            img.classList.add("ring-4", "ring-pink-500");
                            badge.classList.remove("hidden");
                        }
                    };
                    reader.readAsDataURL(file);
                });
            });

            document.querySelectorAll(".existing-image-remove")?.forEach(btn => {
                btn.addEventListener("click", e => {
                    e.preventDefault();
                    const imageDiv = btn.closest(".image-wrapper");
                    const hiddenInput = imageDiv.querySelector("input[name='KeepImages']");
                    if (hiddenInput) hiddenInput.remove();
                    imageDiv.remove();
                });
            });
        });
    </script>
}
