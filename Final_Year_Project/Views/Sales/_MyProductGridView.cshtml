@model IEnumerable<Final_Year_Project.Models.Sales.SellerProductViewModel>

<div class="overflow-x-auto bg-white rounded-xl shadow">
    <table class="min-w-full text-sm text-gray-700">
        <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
            <tr>
                <th class="px-6 py-3 text-left">Image</th>
                <th class="px-6 py-3 text-left">Product Name</th>
                <th class="px-6 py-3 text-left">Price (RM)</th>
                <th class="px-6 py-3 text-left">Stock</th>
                <th class="px-6 py-3 text-left">Status</th>
                <th class="px-6 py-3 text-center">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @foreach (var item in Model)
            {
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-3">
                        <img src="@item.ImagePath"
                             alt="Product" class="w-16 h-16 object-cover rounded-lg border" />
                    </td>
                    <td class="px-6 py-3 font-medium">@item.ProductName</td>
                    <td class="px-6 py-3">@String.Format("{0:N2}", item.Price)</td>
                    <td class="px-6 py-3">@item.StockAvailable</td>
                    <td class="px-6 py-3">
                        @switch(item.Status)
                        {
                            case "available":
                                <span class="px-3 py-1 text-xs font-semibold bg-green-100 text-green-600 rounded-full">Available</span>
                                break;
                            case "outOfStock":
                                <span class="px-3 py-1 text-xs font-semibold bg-red-100 text-white-600 rounded-full">Out Of Stock</span>
                                break;
                            case "unlisted":
                                <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-600 rounded-full">Unlisted</span>
                                break;
                            case "discontinued":
                                <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-600 rounded-full">Discontinued</span>
                                break;
                            default:
                                <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-600 rounded-full">@item.Status</span>
                                break;
                        }
                    </td>
                    <td class="px-6 py-3 text-center">
                        <div class="flex gap-2 justify-center">
                            <a href="@Url.Action("ArtistArtworkDetails", "Sales", new { id = item.ProductId })"
                               class="px-3 py-1 bg-pink-500 text-white rounded hover:bg-purple-600">
                                View
                            </a>

                            <a href="@Url.Action("EditProduct", "Sales", new { id = item.ProductId })"
                               class="px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600">Edit</a>

                            <form asp-action="DeleteProduct"
                                  asp-controller="Sales"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this product?');">

                                <input type="hidden" name="id" value="@item.ProductId" />

                                <button type="submit"
                                        class="p-2 bg-base-200 text-gray rounded hover:bg-red-600 transition flex items-center justify-center"
                                        title="Delete Product">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         viewBox="0 0 25 25"
                                         stroke-width="1.5"
                                         class="w-5 h-5">
                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M6 1h13v1H6zM23 3H2v1h2v18.5A1.502 1.502 0 0 0 5.5 24h14a1.502 1.502 0 0 0 1.5-1.5V4h2zM9 20H8V7h1zm4 0h-1V7h1zm4 0h-1V7h1z" />
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        function confirmDelete(url) {
            if (confirm("Are you sure you want to remove this item?")) {
                window.location.href = url;
            }
        }
    </script>
}
