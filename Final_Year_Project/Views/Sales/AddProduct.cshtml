@model Final_Year_Project.Models.Sales.ProductAddEditViewModel
@{
    ViewData["Title"] = "Add Product";
}

<div class="flex min-h-screen bg-gray-50">
    <div class="flex-1 p-8 overflow-y-auto">
        <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-lg p-8">
            <h2 class="text-3xl font-bold text-gray-800 mb-8 text-center">Add New Product</h2>

            <form asp-action="AddProduct" asp-controller="Sales" method="post" enctype="multipart/form-data" class="space-y-6">
                <div>
                    <label asp-for="Name" class="block text-gray-700 font-medium mb-2">Product Name</label>
                    <input asp-for="Name" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-pink-400 focus:outline-none" />
                    <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="mb-4">
                        <label class="block text-gray-700">Category</label>
                        <select id="CatId" name="CatId" class="w-full border rounded-lg p-2">
                            <option value="">-- Select Category --</option>
                            @foreach (var item in Model.CategoryList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="block text-gray-700">Subcategory</label>
                        <select id="SubCatId" name="SubCatId" class="w-full border rounded-lg p-2">
                            <option value="">-- Select Subcategory --</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Price" class="block text-gray-700 font-medium mb-2">Price (RM)</label>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-pink-400" />
                        <span asp-validation-for="Price" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="ShippingFee" class="block text-gray-700 font-medium mb-2">Shipping Fee (RM)</label>
                        <input asp-for="ShippingFee" type="number" step="0.01" min="0" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-pink-400" />
                        <span asp-validation-for="ShippingFee" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="StockAvailable" class="block text-gray-700 font-medium mb-2">Stock Available</label>
                    <input asp-for="StockAvailable" type="number" min="1" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-pink-400" />
                    <span asp-validation-for="StockAvailable" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Description" class="block text-gray-700 font-medium mb-2">Description</label>
                    <textarea asp-for="Description" rows="4" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-pink-400"></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label class="block text-gray-700 font-medium mb-2">Product Images</label>
                    <input asp-for="Images" id="imageInput" type="file" multiple accept="image/*" class="w-full border border-gray-300 rounded-lg p-3 bg-gray-50" />
                    <p class="text-gray-500 text-sm mt-1">You can upload up to 5 images.</p>
                    <p class="text-gray-500 text-sm mt-1">Only allowed for .jpg. png . jpeg</p>
                    <p class="text-gray-500 text-sm mt-1">Select an image to become the product Thumbnail</p>

                    <div id="imagePreview" class="flex flex-wrap gap-4 mt-4"></div>
                    <input type="hidden" id="PrimaryImageIndex" name="PrimaryImageIndex" value="0" />

                </div>

                <div>
                    <label asp-for="Status" class="block text-gray-700 font-medium mb-2">Status</label>
                    <select asp-for="Status" asp-items="ViewBag.StatusList" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-pink-400">
                    </select>
                    <span asp-validation-for="Status" class="text-red-500 text-sm"></span>
                </div>

                <div class="flex justify-center gap-4 mt-8">
                    <a href="@Url.Action("MyProduct", "Sales")" class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-pink-500 text-white rounded-lg hover:bg-pink-600">Add Product</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const categorySelect = document.getElementById("CatId");
            const subCatSelect = document.getElementById("SubCatId");
            const imageInput = document.getElementById("imageInput");
            const previewContainer = document.getElementById("imagePreview");

            if (categorySelect) {
                categorySelect.addEventListener("change", async function () {
                    const categoryId = this.value;
                    subCatSelect.innerHTML = "<option value=''>-- Select Subcategory --</option>";

                    if (!categoryId) return;

                    const response = await fetch(`/Sales/GetSubCategories?catId=${categoryId}`);
                    const data = await response.json();

                    data.forEach(item => {
                        const option = document.createElement("option");
                        option.value = item.value;
                        option.textContent = item.text;
                        subCatSelect.appendChild(option);
                    });
                });
            }

            if (imageInput && previewContainer) {
            imageInput.addEventListener("change", () => {
                previewContainer.innerHTML = "";
                const files = Array.from(imageInput.files);
                const primaryInput = document.getElementById("PrimaryImageIndex");

                files.forEach((file, index) => {
                    if (!file.type.startsWith("image/")) return;

                    const reader = new FileReader();
                    reader.onload = e => {
                        const wrapper = document.createElement("div");
                        wrapper.classList.add("relative", "inline-block", "group");

                        const img = document.createElement("img");
                        img.src = e.target.result;
                        img.classList.add("w-32", "h-32", "object-cover", "rounded-lg", "shadow-md", "cursor-pointer");

                        const badge = document.createElement("div");
                        badge.textContent = "Primary";
                        badge.classList.add(
                            "absolute", "bottom-1", "left-1",
                            "bg-pink-500", "text-white", "text-xs",
                            "px-2", "py-0.5", "rounded", "hidden"
                        );

                        const removeBtn = document.createElement("button");
                        removeBtn.innerHTML = "×";
                        removeBtn.classList.add(
                            "absolute", "top-0", "right-0",
                            "bg-red-500", "text-white", "rounded-full",
                            "w-6", "h-6", "flex", "items-center",
                            "justify-center", "shadow-md",
                            "hover:bg-red-600", "cursor-pointer"
                        );

                        img.addEventListener("click", () => {
                            previewContainer.querySelectorAll(".ring-4").forEach(el => {
                                el.classList.remove("ring-4", "ring-pink-500");
                                el.nextSibling?.classList.add("hidden");
                            });
                            img.classList.add("ring-4", "ring-pink-500");
                            badge.classList.remove("hidden");
                            primaryInput.value = index;
                        });

                        removeBtn.addEventListener("click", () => {
                            wrapper.remove();
                            const newFiles = files.filter((_, i) => i !== index);
                            const dataTransfer = new DataTransfer();
                            newFiles.forEach(f => dataTransfer.items.add(f));
                            imageInput.files = dataTransfer.files;
                            imageInput.dispatchEvent(new Event("change"));
                        });

                        wrapper.appendChild(img);
                        wrapper.appendChild(badge);
                        wrapper.appendChild(removeBtn);
                        previewContainer.appendChild(wrapper);

                        if (index === 0) {
                            img.classList.add("ring-4", "ring-pink-500");
                            badge.classList.remove("hidden");
                        }
                    };
                    reader.readAsDataURL(file);
                });
            });
            }

            imageInput.addEventListener("change", () => {
                const allowed = ["image/jpeg", "image/png", "image/jpg"];
                const errorSpan = document.querySelector("[data-valmsg-for='Images']");

                errorSpan.innerHTML = "";

                for (const file of imageInput.files) {
                    if (!allowed.includes(file.type)) {
                        errorSpan.innerHTML = "Invalid file type. Only JPG, JPEG, and PNG are allowed.";
                        imageInput.value = ""; // clear invalid files
                        return;
                    }
                }
            });
        });

    </script>
}

