@using Final_Year_Project.Enums
@model Final_Year_Project.Models.Sales.SellerOrderViewModel
@inject Final_Year_Project.Services.EnumService EnumService

@{
    ViewData["Title"] = "Order Details";

    var payment = EnumService.ToEnum<Final_Year_Project.Enums.orderPaymentStatus>(Model.PaymentStatus);
    var order = EnumService.ToEnum<Final_Year_Project.Enums.orderStatus>(Model.OrderStatus);
    var delivery = EnumService.ToEnum<Final_Year_Project.Enums.deliveryStatus>(Model.DeliveryStatus);

    string PaymentText = EnumService.GetEnumDisplayName(payment);
    string OrderText = EnumService.GetEnumDisplayName(order);
    string DeliveryText = EnumService.GetEnumDisplayName(delivery);
}


<div class="flex min-h-screen bg-gray-50">
    @await Html.PartialAsync("_SellerCenterSidebar")

    <main class="flex-1 p-8 overflow-y-auto">
        <div class="mt-8 mb-8">
            <a asp-action="MyOrderList" class="inline-flex px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                &larr; Back to Order List
            </a>
        </div>

        @* Success and Error Messages *@
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
                @TempData["Error"]
            </div>
        }

        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-extrabold text-gray-900">
                <span class="text-indigo-600">@Model.OrderId</span> Order Details
            </h1>
            <div class="flex space-x-4 mt-4">

                @{
                    string paymentColor = payment switch
                    {
                        orderPaymentStatus.paid => "bg-green-100 text-green-700",
                        orderPaymentStatus.pending => "bg-yellow-100 text-yellow-700",
                        orderPaymentStatus.refunded => "bg-blue-100 text-blue-700",
                        _ => "bg-gray-200 text-gray-700"
                    };
                }
                <span class="px-3 py-1 text-xs rounded-full @paymentColor">
                    Payment: @PaymentText
                </span>

                @{
                    string deliveryColor = delivery switch
                    {
                        deliveryStatus.pending => "bg-yellow-100 text-yellow-700",
                        deliveryStatus.delivered => "bg-green-100 text-green-700",
                        deliveryStatus.shipped => "bg-blue-100 text-blue-700",
                        deliveryStatus.packed => "bg-indigo-100 text-indigo-700",
                        deliveryStatus.returned => "bg-red-100 text-red-700",
                        _ => "bg-gray-100 text-gray-700"
                    };
                }
                <span class="px-3 py-1 text-xs rounded-full @deliveryColor">
                    Delivery: @DeliveryText
                </span>

                @{
                    string orderColor = order switch
                    {
                        orderStatus.pending => "bg-yellow-100 text-yellow-700",
                        orderStatus.confirmed => "bg-green-100 text-green-700",
                        orderStatus.processing => "bg-yellow-100 text-yellow-700",
                        orderStatus.cancelled => "bg-red-100 text-red-700",
                        orderStatus.refunded => "bg-blue-100 text-blue-700",
                        _ => "bg-gray-100 text-gray-700"
                    };
                }
                <span class="px-3 py-1 text-xs rounded-full @orderColor">
                    Order: @OrderText
                </span>

            </div>
        </div>

        <hr class="mb-8" />

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <div class="lg:col-span-2 bg-white shadow-xl rounded-lg overflow-hidden p-6">
                <h2 class="text-2xl font-bold text-gray-800 mb-4 border-b pb-2">Order Summary</h2>
                <dl class="grid grid-cols-2 gap-x-4 gap-y-3">
                    <dt class="text-sm font-medium text-gray-500">Order Date:</dt>
                    <dd class="text-sm font-semibold text-gray-900">@Model.OrderDate.ToString("dd MMM yyyy, h:mm tt")</dd>

                    <dt class="text-sm font-medium text-gray-500">Total Amount:</dt>
                    <dd class="text-lg font-extrabold text-indigo-600">RM @Model.TotalAmount.ToString("N2")</dd>

                    <dt class="text-sm font-medium text-gray-500">Buyer Name:</dt>
                    <dd class="text-sm font-medium text-gray-900">@Model.BuyerName</dd>
                </dl>
            </div>

            <div class="bg-white shadow-xl rounded-lg overflow-hidden p-6">
                <h2 class="text-2xl font-bold text-gray-800 mb-4 border-b pb-2">Shipping Details</h2>
                <p class="text-gray-700">
                    @if (!string.IsNullOrEmpty(Model.ShippingAddress))
                    {
                        @Model.ShippingAddress
                    }
                    else
                    {
                        <span class="text-red-500">Shipping address not available.</span>
                    }
                </p>
            </div>
        </div>

        <hr class="my-8" />

        <div class="bg-white shadow-xl rounded-lg p-6">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Items in Order (@Model.Items.Count)</h2>

            <div class="space-y-6">
                @foreach (var item in Model.Items)
                {
                    <div class="flex items-center space-x-4 border-b pb-4 last:border-b-0">
                        <div class="flex-shrink-0 w-20 h-20">
                            <img src="@item.ImagePath" alt="@item.ProductName" class="w-full h-full object-cover rounded-md shadow-md" />
                        </div>

                        <div class="flex-grow">
                            <p class="text-lg font-semibold text-gray-900">@item.ProductName</p>
                            <p class="text-sm text-gray-500">Product ID: @item.ProductId</p>
                        </div>

                        <div class="text-right">
                            <p class="text-md font-medium text-gray-700">Qty: @item.Quantity</p>
                            <p class="text-lg font-bold text-indigo-600">RM @item.Price.ToString("N2") / unit</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Refund Requests Section *@
        @if (Model.RefundRequests != null && Model.RefundRequests.Any())
        {
            <div class="bg-white shadow-xl rounded-lg p-6 mt-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Refund Requests</h2>

                @foreach (var refund in Model.RefundRequests)
                {
                    var statusColor = refund.RefundStatus switch
                    {
                        "pending" => "bg-yellow-100 text-yellow-700 border-yellow-300",
                        "approved" => "bg-green-100 text-green-700 border-green-300",
                        "rejected" => "bg-red-100 text-red-700 border-red-300",
                        "completed" => "bg-blue-100 text-blue-700 border-blue-300",
                        _ => "bg-gray-100 text-gray-700 border-gray-300"
                    };

                    <div class="border border-gray-200 rounded-lg p-4 mb-4 last:mb-0">
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <p class="text-lg font-semibold text-gray-900">@refund.ProductName</p>
                                <p class="text-sm text-gray-500">Requested by: @refund.CustomerName</p>
                                <p class="text-sm text-gray-500">Request Date: @refund.RequestDate.ToString("MMMM dd, yyyy")</p>
                                <p class="text-sm text-gray-500">Due Date: @refund.DueDate.ToString("MMMM dd, yyyy")</p>
                            </div>
                            <span class="px-3 py-1 text-sm font-medium rounded-full border @statusColor">
                                @refund.RefundStatus.ToUpper()
                            </span>
                        </div>

                        <div class="bg-gray-50 rounded-md p-3 mb-3">
                            <p class="text-sm font-medium text-gray-700 mb-1">Reason:</p>
                            <p class="text-sm text-gray-600">@refund.Reason</p>
                        </div>

                        @if (refund.Images != null && refund.Images.Any())
                        {
                            <div>
                                <p class="text-sm font-medium text-gray-700 mb-2">Attached Images:</p>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var image in refund.Images)
                                    {
                                        <a href="@image" target="_blank" class="block">
                                            <img src="@image" alt="Refund evidence" class="w-24 h-24 object-cover rounded border border-gray-300 hover:opacity-80 transition" />
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        @* Approve/Reject buttons for pending refunds *@
                        @if (refund.RefundStatus == "pending")
                        {
                            <div class="flex gap-3 mt-4 pt-4 border-t border-gray-200">
                                <form asp-action="ApproveRefund" method="post" class="inline">
                                    <input type="hidden" name="refundId" value="@refund.RefundId" />
                                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                                    <button type="submit" 
                                            class="px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition"
                                            onclick="return confirm('Are you sure you want to approve this refund request?')">
                                        Approve Refund
                                    </button>
                                </form>
                                <form asp-action="RejectRefund" method="post" class="inline">
                                    <input type="hidden" name="refundId" value="@refund.RefundId" />
                                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                                    <button type="submit" 
                                            class="px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition"
                                            onclick="return confirm('Are you sure you want to reject this refund request?')">
                                        Reject Refund
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <div class="bg-white shadow-xl rounded-lg p-6 mt-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Update Status</h2>

            <form asp-action="UpdateOrderStatus" method="post" class="space-y-6">

                <input type="hidden" name="OrderId" value="@Model.OrderId" />

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Payment Status</label>
                    <select name="PaymentStatus" class="block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="@Model.PaymentStatus" selected>@Model.PaymentStatus</option>
                        @foreach (var status in Model.AllowedPayment)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Delivery Status</label>
                    <select name="DeliveryStatus" class="block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="@Model.DeliveryStatus" selected>@Model.DeliveryStatus</option>
                        @foreach (var status in Model.AllowedDelivery)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Order Status</label>
                    <input type="text" value="@Model.OrderStatus" disabled
                           class="block w-full border-gray-300 rounded-md shadow-sm bg-gray-100 text-gray-600 cursor-not-allowed" />
                    <p class="text-xs text-gray-500 mt-1">This status is updated automatically based on payment and delivery.</p>
                </div>

                <div class="text-right">
                    <button type="submit"
                            class="px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700 transition">
                        Update Status
                    </button>
                </div>

            </form>
        </div>
    </main>
</div>

@section Scripts
{
    <script>
        function updateStatusRules() {
            const payment = document.getElementById("paymentStatus").value;
            const order = document.getElementById("orderStatus").value;
            const delivery = document.getElementById("deliveryStatus").value;

            const paymentSelect = document.getElementById("paymentStatus");
            const orderSelect = document.getElementById("orderStatus");
            const deliverySelect = document.getElementById("deliveryStatus");

            function disableAll(select) {
                [...select.options].forEach(o => o.disabled = true);
            }

            function enable(select, values) {
                [...select.options].forEach(o => {
                    if (values.includes(o.value)) {
                        o.disabled = false;
                    }
                });
            }

            if (payment === "pending") {
                disableAll(orderSelect); enable(orderSelect, ["pending"]);
                disableAll(deliverySelect); enable(deliverySelect, ["pending"]);
                orderSelect.value = "pending";
                deliverySelect.value = "pending";
                return;
            }

            if (payment === "refunded") {
                disableAll(orderSelect); enable(orderSelect, ["refunded"]);
                disableAll(deliverySelect); enable(deliverySelect, ["returned"]);
                orderSelect.value = "refunded";
                deliverySelect.value = "returned";
                return;
            }

            if (payment === "paid") {

                disableAll(orderSelect);
                if (order === "pending") enable(orderSelect, ["pending", "confirmed", "cancelled"]);
                if (order === "confirmed") enable(orderSelect, ["confirmed", "processing", "cancelled"]);
                if (order === "processing") enable(orderSelect, ["processing", "completed"]);
                if (order === "completed") enable(orderSelect, ["completed", "refunded"]);
                if (["cancelled", "refunded"].includes(order)) enable(orderSelect, [order]);

                disableAll(deliverySelect);
                if (delivery === "pending") enable(deliverySelect, ["pending", "packed"]);
                if (delivery === "packed") enable(deliverySelect, ["packed", "shipped"]);
                if (delivery === "shipped") enable(deliverySelect, ["shipped", "delivered"]);
                if (delivery === "delivered") enable(deliverySelect, ["delivered", "returned"]);
                if (delivery === "returned") enable(deliverySelect, ["returned"]);
            }
        }

        document.getElementById("paymentStatus").addEventListener("change", updateStatusRules);
        document.getElementById("orderStatus").addEventListener("change", updateStatusRules);
        document.getElementById("deliveryStatus").addEventListener("change", updateStatusRules);

        updateStatusRules();
    </script>
}