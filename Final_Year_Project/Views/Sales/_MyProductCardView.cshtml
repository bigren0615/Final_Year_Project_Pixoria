@model IEnumerable<Final_Year_Project.Models.Sales.SellerProductViewModel>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    @foreach (var item in Model)
    {
        <div class="bg-white shadow rounded-xl p-4 hover:shadow-lg transition">
            <img src="@item.ImagePath"
                 alt="Product" class="w-full h-48 object-cover rounded-lg mb-3" />

            <h3 class="text-lg font-semibold text-gray-800">@item.ProductName</h3>
            <p class="text-gray-500 text-sm mb-2">@item.Description</p>
            <p class="text-pink-600 font-bold text-lg mb-1">RM @String.Format("{0:N2}", item.Price)</p>
            <p class="text-sm text-gray-600 mb-2">Stock: @item.StockAvailable</p>

            <div class="flex justify-between items-center mt-3">
                @switch (item.Status)
                {
                    case "available":
                        <span class="px-3 py-1 text-xs font-semibold bg-green-100 text-green-600 rounded-full">Available</span>
                        break;
                    case "outOfStock":
                        <span class="px-3 py-1 text-xs font-semibold bg-red-100 text-red-600 rounded-full">Out Of Stock</span>
                        break;
                    case "unlisted":
                        <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-600 rounded-full">Unlisted</span>
                        break;
                    case "discontinued":
                        <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-600 rounded-full">Discontinued</span>
                        break;
                }
            </div>

            <a href="@Url.Action("ArtistArtworkDetails", "Sales", new { id = item.ProductId })"
               class="mt-3 block text-center w-full px-4 py-2 bg-pink-500 text-white font-medium rounded-lg hover:bg-pink-600 transition">
                View Artwork Details
            </a>

            <div class="flex gap-2 mt-3">
                <a href="@Url.Action("EditProduct", "Sales", new { id = item.ProductId })"
                   class="px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600">Edit</a>

                <form asp-action="DeleteProduct"
                       asp-controller="Sales"
                       method="post"
                       onsubmit="return confirm('Are you sure you want to delete this product?');">

                    <input type="hidden" name="id" value="@item.ProductId" />

                    <button type="submit"
                            class="p-2 bg-base-200 text-gray rounded hover:bg-red-600 transition flex items-center justify-center"
                            title="Delete Product">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 25 25"
                             stroke-width="1.5"
                             class="w-5 h-5">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M6 1h13v1H6zM23 3H2v1h2v18.5A1.502 1.502 0 0 0 5.5 24h14a1.502 1.502 0 0 0 1.5-1.5V4h2zM9 20H8V7h1zm4 0h-1V7h1zm4 0h-1V7h1z" />
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    }
</div>
