@model Final_Year_Project.Models.Cart.CheckoutViewModel

<div class="max-w-6xl mx-auto mt-10 grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="bg-white p-6 rounded-lg shadow">
        <h2 class="text-2xl font-bold mb-4">Checkout</h2>

        <p class="text-gray-700 mb-2">
            <strong>Username:</strong> @Model.Username (@Model.PhoneNumber)
        </p>

        @{
            var subtotal = Model.CartItems.Sum(i => (i.Price + i.ShippingFee) * i.Quantity);
            var serviceTax = subtotal * 0.10;
            var sst = subtotal * 0.06;
            var total = subtotal + serviceTax + sst;
        }

        <div class="mb-4">
            <h3 class="font-semibold text-lg">Shipping Address</h3>
            @if (!string.IsNullOrEmpty(Model.Address))
            {
                <div class="border rounded p-3 bg-gray-50">
                    <p class="text-gray-700">@Model.Address</p>
                    <button type="button"
                            onclick="window.location.href='@Url.Action("Address", "Profile")'"
                            class="text-blue-500 hover:underline text-sm mt-2">
                        Change
                    </button>
                </div>
            }
            else
            {
                <div class="border rounded p-3 bg-gray-50">
                    <p class="text-gray-700">You do not have any default shipping address yet. Try adding one!</p>
                    <button type="button"
                            onclick="window.location.href='@Url.Action("Address", "Profile")'"
                            class="text-blue-500 hover:underline text-sm mt-2">
                        Add Address
                    </button>
                </div>
            }
        </div>

        <div class="mb-4">
            <h3 class="font-semibold text-lg">Voucher</h3>
            <form asp-action="ApplyVoucher" method="post" class="flex gap-2">
                <input type="text" name="voucherCode" class="border rounded px-2 py-1 w-2/3" placeholder="Enter voucher code" />
                <button type="submit" class="bg-gray-800 text-white px-4 py-1 rounded hover:bg-gray-700">Use</button>
            </form>
        </div>


        <div class="flex gap-3">
            <a href="/Cart/ViewCart" class="bg-gray-300 hover:bg-gray-400 text-black px-6 py-2 rounded">Back</a>
            <form asp-action="CreateCheckoutSession" asp-controller="Payment" method="post">
                <input type="hidden" name="total" value="@total" />

                <button type="submit"
                        class="bg-gray-800 hover:bg-black text-white px-6 py-2 rounded
                   @(string.IsNullOrEmpty(Model.Address) ? "opacity-50 cursor-not-allowed" : "")"
                        @(string.IsNullOrEmpty(Model.Address) ? "disabled" : "")>
                    Payment
                </button>
            </form>
        </div>
    </div>

    <div class="bg-white p-6 rounded-lg shadow">
        <h3 class="text-xl font-bold mb-4">Product List</h3>
        @foreach (var item in Model.CartItems)
        {
            <div class="flex gap-4 border-b pb-4 mb-4">
                <img src="@item.Image" alt="@item.ArtworkName" class="w-20 h-20 rounded object-cover" />
                <div>
                    <p class="font-semibold">@item.ArtworkName</p>
                    <p>Quantity: @item.Quantity</p>
                    <p>Price: RM @item.Price.ToString("F2")</p>
                    <p>Shipping Fee: RM @item.ShippingFee.ToString("F2")</p>
                    <p class="text-sm text-gray-600">
                        Subtotal: RM @(((item.Price + item.ShippingFee) * item.Quantity).ToString("F2"))
                    </p>
                </div>
            </div>
        }

        <div class="text-right space-y-1 mt-4 text-gray-700">
            <p>Subtotal (incl. shipping): RM @subtotal.ToString("F2")</p>
            <p>Service Tax (10%): RM @serviceTax.ToString("F2")</p>
            <p>SST (6%): RM @sst.ToString("F2")</p>
            <p class="font-bold text-lg mt-2">Total: RM @total.ToString("F2")</p>
        </div>
    </div>
</div>
